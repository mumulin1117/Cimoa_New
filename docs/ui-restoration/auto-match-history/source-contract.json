    "fragment": "    <sc-if value=\"{{ isAmHistory }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Auto Match / History / Default\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">Auto Match history</div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 40px;box-sizing:border-box\">\n          <div style=\"font-size:16px;color:#5b6b85;text-wrap:pretty\">Connected matches, pending decisions, and expired matches from the last 30 days.</div>\n          <div style=\"display:flex;flex-direction:column;gap:12px;margin-top:18px\">\n            <sc-for list=\"{{ historyRows }}\" as=\"h\" hint-placeholder-count=\"3\">\n              <div sc-camel-on-click=\"{{ h.go }}\" style=\"display:flex;align-items:center;gap:12px;padding:14px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\">\n                <sc-if value=\"{{ h.img }}\" hint-placeholder-val=\"{{ false }}\"><img src=\"{{ h.img }}\" alt=\"{{ h.name }}\" style=\"width:52px;height:52px;border-radius:26px;object-fit:cover;flex:none;display:block\"></sc-if>\n                <sc-if value=\"{{ h.noImg }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"width:52px;height:52px;border-radius:26px;background:#eef2f8;flex:none\"></div></sc-if>\n                <div style=\"flex:1;min-width:0\">\n                  <div style=\"font-size:18px;font-weight:800;letter-spacing:-0.02em;white-space:nowrap\">{{ h.name }}</div>\n                  <div style=\"font-size:14.5px;color:#5b6b85;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">{{ h.meta }}</div>\n                </div>\n                <div style=\"padding:7px 11px;border-radius:16px;background:{{ h.pill }};flex:none\"><div style=\"font-size:13.5px;font-weight:600;color:{{ h.pillInk }}\">{{ h.pillText }}</div></div>\n              </div>\n            </sc-for>\n          </div>\n        </div>\n      </div>\n    </sc-if>",
