  "approved_deltas": [
    {
      "id": "login-safe-area-and-skeleton",
      "source": "DEVELOPMENT_CONVENTIONS.md 15.1",
      "delta": "Replace prototype system chrome and absolute overlay scroll compensation with measured Top/BottomSafeArea, a fixed header/footer and one flex middle scroll region while preserving source coordinates at the reference safe area."
    },
    {
      "id": "login-local-authentication",
      "source": "INTERACTION_CONVENTIONS.md 9.2 and user decision",
      "delta": "Validate the real local account and password, persist a session only on success, then prepare one main-tab skeleton cycle and route to verification, onboarding or Home from Store state instead of blindly entering Home."
    },
    {
      "id": "login-local-mode-disclosure",
      "source": "INTERACTION_CONVENTIONS.md 9.2",
      "delta": "Display the exact local-mode disclosure: Local accounts are stored on this device. Signing in does not verify your student status. It must follow the complete source control group rather than replace it."
    },
    {
      "id": "login-email-only",
      "source": "User decision 2026-10-17",
      "delta": "Remove Apple sign-in functionality, button, icon and or-divider. Email fields follow the unchanged source heading with the source 14px field margin. This supersedes the earlier Apple-unavailable delta; original Apple entries remain provenance only."
    },
    {
      "id": "login-write-loading",
      "source": "DEVELOPMENT_CONVENTIONS.md 7",
      "delta": "Show the project custom 400-600ms write Loading before a login attempt that can persist session state; cancel cleanly on hide or unmount."
    },
    {
      "id": "login-password-privacy",
      "source": "INTERACTION_CONVENTIONS.md login contract",
      "delta": "Render the password input hidden by default, make Show/Hide affect the actual input type, keep password only in memory and clear it on hide or unmount."
    }
