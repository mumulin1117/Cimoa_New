    "fragment": "<sc-if value=\"{{ isProfile }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Profile / Personal / Default\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">My profile</div><div sc-camel-on-click=\"{{ openAppSettings }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\"><svg width=\"21\" height=\"21\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z\"></path><path d=\"M19.4 13a7.6 7.6 0 0 0 0-2l2-1.4-2-3.4-2.3.7a7.6 7.6 0 0 0-1.7-1L15 3h-6l-.4 2.9a7.6 7.6 0 0 0-1.7 1l-2.3-.7-2 3.4L4.6 11a7.6 7.6 0 0 0 0 2l-2 1.4 2 3.4 2.3-.7a7.6 7.6 0 0 0 1.7 1L9 21h6l.4-2.9a7.6 7.6 0 0 0 1.7-1l2.3.7 2-3.4z\"></path></svg></div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:40px;overflow-y:auto;scrollbar-width:none;padding:0 20px 40px;box-sizing:border-box\">\n          <div style=\"display:flex;flex-direction:column;align-items:center;gap:10px\">\n            <div style=\"position:relative\">\n              <img src=\"6cba2be3-a0e0-4813-b4ab-4aa65ed6aa30\" alt=\"{{ obName }}\" style=\"width:120px;height:120px;border-radius:60px;object-fit:cover;box-shadow:0 12px 28px rgba(16,36,74,0.14);display:block;border:3px solid #fff\">\n            </div>\n            <div style=\"display:flex;align-items:center;gap:7px;margin-top:4px\">\n              <div style=\"font-size:27px;font-weight:800;letter-spacing:-0.03em\">{{ obName }}, 22</div>\n              <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#1d9bf0\"></circle><path d=\"m7.5 12.4 3 3 6-6.4\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n            </div>\n            <div style=\"display:flex;flex-wrap:nowrap;justify-content:center;gap:6px;max-width:100%;padding:0 16px;box-sizing:border-box\">\n              <div style=\"display:flex;align-items:center;gap:4px;height:30px;padding:0 10px;border-radius:15px;min-width:0;background:#fff;box-shadow:0 4px 12px rgba(16,36,74,0.07)\"><svg width=\"13\" height=\"13\" style=\"flex:none\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 8.5l10-4.5 10 4.5-10 4.5z\"></path><path d=\"M6 10.8v4.4c0 1.4 2.7 2.8 6 2.8s6-1.4 6-2.8v-4.4\"></path><path d=\"M22 8.5v5\"></path></svg><div style=\"font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">HKUST</div></div>\n              <div style=\"display:flex;align-items:center;gap:4px;height:30px;padding:0 10px;border-radius:15px;min-width:0;background:#fff;box-shadow:0 4px 12px rgba(16,36,74,0.07)\"><svg width=\"13\" height=\"13\" style=\"flex:none\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.5 5.5c3.2-1 6.3-.7 9.5 1.2 3.2-1.9 6.3-2.2 9.5-1.2v13c-3.2-1-6.3-.7-9.5 1.2-3.2-1.9-6.3-2.2-9.5-1.2z\"></path><path d=\"M12 6.7v13\"></path></svg><div style=\"font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">{{ obField }}</div></div>\n              <div style=\"display:flex;align-items:center;gap:4px;height:30px;padding:0 10px;border-radius:15px;min-width:0;background:#fff;box-shadow:0 4px 12px rgba(16,36,74,0.07)\"><svg width=\"13\" height=\"13\" style=\"flex:none\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9.2 3.8a2.3 2.3 0 0 1 4.6 0V5H17a1 1 0 0 1 1 1v3.3h1.2a2.3 2.3 0 0 1 0 4.6H18V18a1 1 0 0 1-1 1h-3.3v-1.2a2.3 2.3 0 0 0-4.6 0V19H6a1 1 0 0 1-1-1v-3.4h1.2a2.3 2.3 0 0 0 0-4.6H5V6a1 1 0 0 1 1-1h3.2z\"></path></svg><div style=\"font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">INFP</div></div>\n            </div>\n            <div sc-camel-on-click=\"{{ openEditBasic }}\" style=\"height:48px;padding:0 26px;border-radius:24px;background:linear-gradient(#ffffff,#ffffff) padding-box, linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%) border-box;border:2px solid transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;margin-top:10px;gap:8px\">\n              <svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#4a7bf7\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20h4L19 9l-4-4L4 16z\"></path><path d=\"M13.5 6.5l4 4\"></path></svg>\n              <div style=\"font-size:17px;font-weight:700;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);-webkit-background-clip:text;background-clip:text;color:transparent\">Edit Profile</div>\n            </div>\n          </div>\n\n          <div style=\"margin-top:22px;padding:18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <div style=\"font-size:22px;font-weight:800;letter-spacing:-0.02em\">About me</div>\n            <div style=\"font-family:'Caveat',cursive;font-size:27px;font-weight:600;line-height:1.25;color:#26364f;margin-top:8px;text-align:center;text-wrap:balance\">{{ obBio }}</div>\n          </div>\n\n          <div style=\"margin-top:16px;padding:18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <div style=\"font-size:22px;font-weight:800;letter-spacing:-0.02em\">Interests</div>\n            <div style=\"display:flex;flex-wrap:wrap;gap:18px;margin-top:14px\">\n              <sc-for list=\"{{ selectedInterests }}\" as=\"o\" hint-placeholder-count=\"3\">\n                <div style=\"display:flex;flex-direction:column;align-items:center;gap:8px;width:74px\">\n                  <div style=\"width:56px;height:56px;border-radius:28px;background:#eef2f8;display:flex;align-items:center;justify-content:center;font-size:24px\">{{ o.icon }}</div>\n                  <div style=\"font-size:14.5px;font-weight:600;text-align:center\">{{ o.label }}</div>\n                </div>\n              </sc-for>\n            </div>\n          </div>\n\n          <div sc-camel-on-click=\"{{ openStore }}\" style=\"display:flex;align-items:center;gap:14px;margin-top:16px;padding:16px 18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\">\n            <img src=\"a9831494-dfeb-464f-8617-1e3468ad74f0\" alt=\"coin\" style=\"width:40px;height:40px;display:block;flex:none\">\n            <div style=\"flex:1;min-width:0;font-size:19px;font-weight:800;letter-spacing:-0.02em\">{{ balanceText }}</div>\n            <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\" style=\"flex:none\"><path d=\"M9 5l7 7-7 7\"></path></svg>\n          </div>\n\n          <div sc-camel-on-click=\"{{ openProfilePreview }}\" style=\"display:flex;align-items:center;gap:14px;margin-top:16px;padding:16px 18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\">\n            <div style=\"width:40px;height:40px;border-radius:20px;background:#eef2f8;display:flex;align-items:center;justify-content:center;flex:none\"><svg width=\"19\" height=\"19\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#44536b\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"8.5\" r=\"3.8\"></circle><path d=\"M4.5 20c1.4-4.2 5-6 7.5-6s6.1 1.8 7.5 6\"></path></svg></div>\n            <div style=\"flex:1;min-width:0;font-size:17px;font-weight:700\">Preview my profile</div>\n            <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\" style=\"flex:none\"><path d=\"M9 5l7 7-7 7\"></path></svg>\n          </div>\n        </div>\n      </div>\n    </sc-if>"
  },
