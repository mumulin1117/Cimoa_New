9.5h3.5L13 5v14L7.5 14.5H4z\"></path><path d=\"M17 9a4.5 4.5 0 0 1 0 6\"></path></svg></div>\n          </div>\n          <div sc-camel-on-click=\"{{ endCall }}\" style=\"cursor:pointer\">\n            <div style=\"width:64px;height:64px;border-radius:32px;background:#ef4444;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 24px rgba(239,68,68,0.4)\">\n              <svg width=\"30\" height=\"30\" sc-camel-view-box=\"0 0 24 24\" fill=\"#fff\"><path d=\"M12 9.2c-3.3 0-6.3 1-8.6 2.8-.6.5-.9 1.2-.8 2l.3 1.8c.1.8.9 1.3 1.7 1.1l3-.8c.6-.2 1-.7 1-1.3v-1.6c1.1-.4 2.2-.5 3.4-.5s2.3.1 3.4.5v1.6c0 .6.4 1.1 1 1.3l3 .8c.8.2 1.6-.3 1.7-1.1l.3-1.8c.1-.8-.2-1.5-.8-2-2.3-1.8-5.3-2.8-8.6-2.8z\"></path></svg>\n            </div>\n          </div>\n        </div>\n      </div>\n    </sc-if>"
