    "fragment": "    <sc-if value=\"{{ isCallActive }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Video Call / Active / Default\" style=\"position:absolute;inset:0;background:#08101f;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;display:flex;justify-content:space-between;z-index:30;pointer-events:none\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:44px;height:44px;border-radius:22px;background:rgba(8,16,31,0.38);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.18);display:flex;align-items:center;justify-content:center;cursor:pointer;box-sizing:border-box;pointer-events:auto\"><svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg></div>\n          <div sc-camel-on-click=\"{{ openSafetyMini }}\" style=\"width:44px;height:44px;border-radius:22px;background:rgba(8,16,31,0.38);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.18);display:flex;align-items:center;justify-content:center;cursor:pointer;box-sizing:border-box;pointer-events:auto\"><svg width=\"21\" height=\"21\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.1\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 21V4\"></path><path d=\"M5 4h11l-2 4 2 4H5\"></path></svg></div>\n        </div>\n        <img src=\"be199ee7-6704-4324-98d1-52394676c49a\" alt=\"Chloe Lin\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 18%;display:block\">\n        <div style=\"position:absolute;top:0;left:0;right:0;height:180px;background:linear-gradient(to bottom,rgba(8,16,31,0.6),rgba(8,16,31,0))\"></div>\n        <div style=\"position:absolute;left:0;right:0;bottom:0;height:260px;background:linear-gradient(to top,rgba(8,16,31,0.82),rgba(8,16,31,0))\"></div>\n        <div style=\"position:absolute;top:66px;left:0;right:0;display:flex;flex-direction:column;align-items:center;gap:5px\">\n          <div style=\"font-size:19px;font-weight:700;color:#fff;letter-spacing:-0.02em\">Chloe Lin</div>\n          <div style=\"font-size:15px;color:rgba(255,255,255,0.82);font-variant-numeric:tabular-nums\">{{ callTimer }}</div>\n          <svg width=\"15\" height=\"15\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#22c55e\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"10\" width=\"14\" height=\"10\" rx=\"2.5\"></rect><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"></path></svg>\n        </div>\n        <div style=\"position:absolute;top:116px;right:20px;width:104px;height:142px;border-radius:20px;overflow:hidden;border:2px solid rgba(255,255,255,0.4);background:#0b1b3a\">\n          <img src=\"6cba2be3-a0e0-4813-b4ab-4aa65ed6aa30\" alt=\"Your camera\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n          <sc-if value=\"{{ camOff }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"position:absolute;inset:0;background:rgba(8,16,31,0.88);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;color:rgba(255,255,255,0.8);text-align:center;padding:8px\">Camera off</div>\n          </sc-if>\n        </div>\n        <div style=\"position:absolute;left:0;right:0;bottom:130px;display:flex;align-items:center;justify-content:center;gap:8px\">\n          <div style=\"width:8px;height:8px;border-radius:4px;background:#22c55e\"></div>\n          <div style=\"font-size:15px;font-weight:600;color:rgba(255,255,255,0.85)\">Connected</div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:44px;display:flex;align-items:center;justify-content:space-between\">\n<div sc-camel-on-click=\"{{ toggleMute }}\" style=\"cursor:pointer\">\n           