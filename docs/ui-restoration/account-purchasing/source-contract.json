    "fragment": "<sc-if value=\"{{ isCoinPurchasing }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Coins / Store / Purchasing\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">Coins</div>\n        </div>\n        <div style=\"position:absolute;top:150px;left:20px;right:20px\">\n          <div style=\"display:flex;align-items:center;gap:14px;padding:18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <img src=\"a9831494-dfeb-464f-8617-1e3468ad74f0\" alt=\"coin\" style=\"width:42px;height:42px;display:block;flex:none\">\n            <div style=\"flex:1;min-width:0\">\n              <div style=\"font-size:20px;font-weight:800;letter-spacing:-0.025em\">{{ selPkgCoins }}</div>\n              <div style=\"font-size:15px;color:#5b6b85;margin-top:2px\">Selected package</div>\n            </div>\n            <div style=\"font-size:18px;font-weight:700;flex:none\">{{ selPkgPrice }}</div>\n          </div>\n          <div style=\"display:flex;flex-direction:column;align-items:center;gap:16px;margin-top:40px\">\n            <div style=\"width:74px;height:74px;border-radius:37px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);opacity:0.9;animation:cPulse 1800ms ease-in-out infinite\"></div>\n            <div style=\"font-size:19px;font-weight:700\">Connecting to the App Store…</div>\n            <div style=\"font-size:16px;color:#5b6b85;text-align:center;max-width:280px;text-wrap:pretty\">Nothing has been charged yet and no coins have been added.</div>\n          </div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:34px;z-index:20\"><div sc-camel-on-click=\"{{ backToStore }}\" style=\"height:56px;border-radius:28px;background:#fff;box-shadow:0 8px 22px rgba(16,36,74,0.07);display:flex;align-items:center;justify-content:center;cursor:pointer\"><div style=\"font-size:18px;font-weight:600;color:#0b1b3a\">Cancel</div></div></div>\n      </div>\n    </sc-if>"
  },
