    "fragment": "<sc-if value=\"{{ isReportDetail }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Safety / Report Detail / Default\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">Report detail</div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 120px;box-sizing:border-box\">\n          <div style=\"padding:6px 18px 12px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <div style=\"display:flex;align-items:center;justify-content:space-between;height:52px;border-bottom:1px solid #eef1f6\">\n              <div style=\"font-size:17px;color:#5b6b85\">Category</div>\n              <div style=\"font-size:17px;font-weight:700\">{{ selReportCategory }}</div>\n            </div>\n            <div style=\"display:flex;align-items:center;justify-content:space-between;height:52px;border-bottom:1px solid #eef1f6\">\n              <div style=\"font-size:17px;color:#5b6b85\">Submitted</div>\n              <div style=\"font-size:17px;font-weight:700\">{{ selReportWhen }}</div>\n            </div>\n            <div style=\"display:flex;align-items:center;justify-content:space-between;height:52px;border-bottom:1px solid #eef1f6\">\n              <div style=\"font-size:17px;color:#5b6b85\">Status</div>\n              <div style=\"font-size:17px;font-weight:700\">{{ selReportStatus }}</div>\n            </div>\n          </div>\n          <div style=\"font-size:17px;font-weight:700;margin-top:18px\">Your description</div>\n          <div style=\"font-size:16.5px;line-height:1.5;color:#26364f;margin-top:8px;text-wrap:pretty\">{{ selReportDesc }}</div>\n          <div style=\"font-size:15px;color:#8b95a6;margin-top:16px;text-wrap:pretty\">Moderation decisions and other users’ private information aren’t shown here.</div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:34px;z-index:20\"><div sc-camel-on-click=\"{{ openSetSupport }}\" style=\"height:56px;border-radius:28px;background:#fff;box-shadow:0 8px 22px rgba(16,36,74,0.07);display:flex;align-items:center;justify-content:center;cursor:pointer\"><div style=\"font-size:18px;font-weight:600;color:#0b1b3a\">Contact Support</div></div></div>\n      </div>\n    </sc-if>"
  },
