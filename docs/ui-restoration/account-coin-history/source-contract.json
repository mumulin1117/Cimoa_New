    "fragment": "<sc-if value=\"{{ isCoinHistory }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Coins / History / Default\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">Transactions</div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 40px;box-sizing:border-box\">\n          <div style=\"display:flex;align-items:center;gap:14px;padding:18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <img src=\"a9831494-dfeb-464f-8617-1e3468ad74f0\" alt=\"coin\" style=\"width:46px;height:46px;display:block;flex:none\">\n            <div style=\"flex:1;min-width:0\">\n              <div style=\"font-size:14.5px;color:#5b6b85\">Current balance</div>\n              <div style=\"font-size:26px;font-weight:800;letter-spacing:-0.03em;margin-top:1px\">{{ balanceText }}</div>\n            </div>\n          </div>\n          <div style=\"display:flex;gap:10px;margin-top:16px\">\n            <sc-for list=\"{{ histFilters }}\" as=\"h\" hint-placeholder-count=\"3\">\n              <div sc-camel-on-click=\"{{ h.pick }}\" style=\"height:44px;padding:0 18px;border-radius:22px;display:flex;align-items:center;cursor:pointer;font-size:16px;font-weight:600;background:{{ h.bg }};color:{{ h.ink }};box-shadow:0 6px 16px rgba(16,36,74,0.06)\">{{ h.label }}</div>\n            </sc-for>\n          </div>\n          <div style=\"display:flex;flex-direction:column;gap:12px;margin-top:16px\">\n            <sc-for list=\"{{ txnRows }}\" as=\"t\" hint-placeholder-count=\"3\">\n              <div sc-camel-on-click=\"{{ t.go }}\" style=\"display:flex;align-items:center;gap:12px;padding:16px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\">\n                <div style=\"flex:1;min-width:0\">\n                  <div style=\"font-size:18px;font-weight:800;letter-spacing:-0.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">{{ t.title }}</div>\n                  <div style=\"font-size:14.5px;color:#5b6b85;margin-top:3px\">{{ t.when }}</div>\n                  <div style=\"display:inline-flex;margin-top:8px;padding:5px 10px;border-radius:14px;background:{{ t.statusBg }}\"><div style=\"font-size:12.5px;font-weight:700;color:{{ t.statusInk }}\">{{ t.status }}</div></div>\n                </div>\n                <div style=\"font-size:20px;font-weight:800;letter-spacing:-0.02em;color:{{ t.amountInk }};flex:none\">{{ t.amount }}</div>\n              </div>\n            </sc-for>\n          </div>\n        </div>\n      </div>\n    </sc-if>"
  },
