    "fragment_sha256": "fa2b6a2b179d72ac0b6e8a865228ba0e004ea624bd665a51f733e92af72c6267",
    "fragment": "<sc-if value=\"{{ isEvents }}\" hint-placeholder-val=\"{{ true }}\">\n      <div data-screen-label=\"{{ eventsLabel }}\" style=\"position:absolute;inset:0;animation:cRise 260ms ease both\">\n        <div class=\"cscroll\" style=\"position:absolute;top:54px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 130px;box-sizing:border-box\">\n\n          <div style=\"display:flex;align-items:center;justify-content:space-between;padding-top:6px\">\n            <div sc-camel-on-click=\"{{ openMe }}\" style=\"width:54px;height:54px;border-radius:27px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer\"><svg width=\"26\" height=\"26\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"8.5\" r=\"3.8\"></circle><path d=\"M4.5 20c1.4-4.2 5-6 7.5-6s6.1 1.8 7.5 6\"></path></svg></div>\n            <div sc-camel-on-click=\"{{ openMyEvents }}\" style=\"display:flex;align-items:center;gap:8px;height:48px;padding:0 18px;border-radius:24px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);cursor:pointer;flex:none\">\n              <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"M8 3v3M16 3v3M3 10h18\"></path><path d=\"m9 15 2 2 4-4\"></path></svg>\n              <div style=\"font-size:16px;font-weight:700;color:#0b1b3a;white-space:nowrap\">My Events</div>\n            </div>\n          </div>\n\n          <div style=\"margin-top:14px\">\n            <div style=\"font-size:38px;line-height:1.04;font-weight:800;letter-spacing:-0.035em\">Campus events</div>\n          </div>\n          <div style=\"font-size:17px;color:#5b6b85;margin-top:8px\">Meet around something you enjoy.</div>\n\n          <div style=\"display:flex;gap:10px;margin-top:18px\">\n            <div sc-camel-on-click=\"{{ chipToday }}\" style=\"height:52px;padding:0 20px;border-radius:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:17px;font-weight:600;white-space:nowrap;background:{{ chipTodayBg }};color:{{ chipTodayInk }};box-shadow:0 6px 18px rgba(16,36,74,0.08)\">Today</div>\n            <div sc-camel-on-click=\"{{ chipWeek }}\" style=\"height:52px;padding:0 20px;border-radius:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:17px;font-weight:600;white-space:nowrap;background:{{ chipWeekBg }};color:{{ chipWeekInk }};box-shadow:0 6px 18px rgba(16,36,74,0.08)\">This week</div>\n            <div sc-camel-on-click=\"{{ chipCampus }}\" style=\"height:52px;padding:0 20px;border-radius:26px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:17px;font-weight:600;white-space:nowrap;background:{{ chipCampusBg }};color:{{ chipCampusInk }};box-shadow:0 6px 18px rgba(16,36,74,0.08)\">My campus</div>\n          </div>\n\n          <div class=\"cscroll\" style=\"display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;margin:14px -20px 0;padding:4px 20px 18px;box-sizing:border-box\">\n          <div style=\"flex:none;width:calc(100% - 44px);scroll-snap-align:start;scroll-margin-left:20px;border-radius:26px;background:#fff;box-shadow:0 12px 30px rgba(16,36,74,0.09);overflow:hidden\">\n            <img sc-camel-on-click=\"{{ openEvent }}\" src=\"b8e65a72-456c-4c6d-ac60-b015015a3ac4\" alt=\"{{ featuredTitle }}\" style=\"width:100%;height:214px;object-fit:cover;display:block;cursor:pointer\">\n            <div style=\"padding:14px 16px 16px\">\n              <div sc-camel-on-click=\"{{ openEvent }}\" style=\"font-size:23px;font-weight:800;letter-spacing:-0.03em;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">{{ featuredTitle }}</div>\n              <div style=\"display:flex;align-items:center;gap:9px;margin-top:8px\">\n                <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"1.9\" stroke-linecap=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"M8 3v3M16 3v3M3 10h18\"></path></svg>\n                <div style=\"font-size:17px\">{{ featuredWhen }}</div>\n              </div>\n              <div style=\"display:flex;align-items:center;gap:9px;margin-top:7px\">\n                <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z\"></path><circle cx=\"12\" cy=\"10\" r=\"2.6\"></circle></svg>\n                <div style=\"font-size:17px\">{{ featuredPlace }}</div>\n              </div>\n              <div sc-camel-on-click=\"{{ openParticipants }}\" style=\"display:flex;align-items:center;gap:12px;margin-top:12px;cursor:pointer\">\n                <div style=\"display:flex\">\n                  <img src=\"ceafb32c-3d48-4ad1-a03e-d45b4d907d80\" alt=\"\" style=\"width:36px;height:36px;border-radius:18px;object-fit:cover;border:2px solid #fff;display:block\">\n                  <img src=\"e8bd8155-5a13-4ecb-a022-bcadf12ae5f6\" alt=\"\" style=\"width:36px;height:36px;border-radius:18px;object-fit:cover;border:2px solid #fff;margin-left:-11px;display:block\">\n                  <img src=\"38b22b41-ac8f-43cc-8bf0-37a8b75c93b4\" alt=\"\" style=\"width:36px;height:36px;border-radius:18px;object-fit:cover;border:2px solid #fff;margin-left:-11px;display:block\">\n                  <img src=\"92ddcb8c-721c-4960-a8e8-51926692ee27\" alt=\"\" style=\"width:36px;height:36px;border-radius:18px;object-fit:cover;border:2px solid #fff;margin-left:-11px;display:block\">\n                </div>\n                <div style=\"font-size:15px;color:#5b6b85;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">{{ featuredGoing }} · {{ evSpots }}</div>\n              </div>\n              <div sc-camel-on-click=\"{{ evJoinTap }}\" style=\"margin-top:14px;height:52px;border-radius:26px;display:flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;background:{{ joinBg }};box-shadow:{{ joinShadow }}\">\n                <div style=\"font-size:19px;font-weight:700;color:{{ joinInk }}\">{{ joinLabel }}</div>\n              </div>\n              <sc-if value=\"{{ joined }}\" hint-placeholder-val=\"{{ false }}\">\n                <div style=\"display:flex;gap:12px;margin-top:12px;justify-content:center\">\n                  <div sc-camel-on-click=\"{{ openGroup }}\" style=\"font-size:16px;font-weight:600;color:#2563eb;cursor:pointer\">Event group chat</div>\n                  <div style=\"width:1px;background:#e2e8f0\"></div>\n                  <div sc-camel-on-click=\"{{ manageAttendance }}\" style=\"font-size:16px;font-weight:600;color:#64748b;cursor:pointer\">Manage</div>\n                </div>\n              </sc-if>\n            </div>\n          </div>\n            <sc-for list=\"{{ moreFeatured }}\" as=\"m\" hint-placeholder-count=\"2\">\n              <div sc-camel-on-click=\"{{ m.open }}\" style=\"flex:none;width:calc(100% - 44px);scroll-snap-align:start;scroll-margin-left:20px;border-radius:26px;background:#fff;box-shadow:0 12px 30px rgba(16,36,74,0.09);overflow:hidden;cursor:pointer;display:flex;flex-direction:column\">\n                <div style=\"height:214px;background:{{ m.cover }};display:flex;align-items:center;justify-content:center;font-size:64px\">{{ m.emoji }}</div>\n                <div style=\"padding:14px 16px 16px;display:flex;flex-direction:column;flex:1\">\n                  <div style=\"font-size:23px;font-weight:800;letter-spacing:-0.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">{{ m.title }}</div>\n                  <div style=\"display:flex;align-items:center;gap:9px;margin-top:8px\">\n                    <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"1.9\" stroke-linecap=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"M8 3v3M16 3v3M3 10h18\"></path></svg>\n                    <div style=\"font-size:17px\">{{ m.when }}</div>\n                  </div>\n                  <div style=\"display:flex;align-items:center;gap:9px;margin-top:7px\">\n                    <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z\"></path><circle cx=\"12\" cy=\"10\" r=\"2.6\"></circle></svg>\n                    <div style=\"font-size:17px\">{{ m.place }}</div>\n                  </div>\n                  <div style=\"display:flex;align-items:center;gap:12px;margin-top:12px\">\n                    <div style=\"display:flex\">\n                      <img src=\"ceafb32c-3d48-4ad1-a03e-d45b4d907d80\" alt=\"\" style=\"width:36px;height:36px;border-radius:18px;object-fit:cover;border:2px solid #fff;display:block\">\n                      <img src=\"e8bd8155-5a13-4ecb-a022-bcadf12ae5f6\" alt=\"\" style=\"width:36px;height:36px;border-radius:18px;object-fit:cover;border:2px solid #fff;margin-left:-11px;display:block\">\n                      <img src=\"38b22b41-ac8f-43cc-8bf0-37a8b75c93b4\" alt=\"\" style=\"width:36px;height:36px;border-radius:18px;object-fit:cover;border:2px solid #fff;margin-left:-11px;display:block\">\n                      <img src=\"92ddcb8c-721c-4960-a8e8-51926692ee27\" alt=\"\" style=\"width:36px;height:36px;border-radius:18px;object-fit:cover;border:2px solid #fff;margin-left:-11px;display:block\">\n                    </div>\n                    <div style=\"font-size:15px;color:#5b6b85;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">{{ m.going }} · {{ m.spots }}</div>\n                  </div>\n                  <div style=\"margin-top:auto;padding-top:14px\">\n                    <div sc-camel-on-click=\"{{ m.join }}\" style=\"height:52px;border-radius:26px;display:flex;align-items:center;justify-content:center;background:{{ m.btnBg }};box-shadow:{{ m.btnShadow }}\"><div style=\"font-size:19px;font-weight:700;color:{{ m.btnInk }}\">{{ m.btnLabel }}</div></div>\n                  </div>\n                </div>\n              </div>\n            </sc-for>\n          </div>\n\n        </div>\n      </div>\n    </sc-if>"
  },
