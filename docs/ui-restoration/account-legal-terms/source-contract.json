    "fragment": "<sc-if value=\"{{ isLegalDoc }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"{{ legalLabel }}\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\"><svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg></div>\n          <div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">{{ legalTitle }}</div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 48px;box-sizing:border-box\">\n          <div style=\"font-size:14px;color:#8b95a6\">Last updated · 1 September 2026</div>\n          <div style=\"font-size:16px;line-height:1.55;color:#26364f;margin-top:12px;text-wrap:pretty\">{{ legalIntro }}</div>\n          <div style=\"margin-top:18px;padding:6px 20px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <sc-for list=\"{{ legalSections }}\" as=\"l\" hint-placeholder-count=\"6\">\n              <div style=\"padding:16px 0;border-bottom:{{ l.bd }}\">\n                <div style=\"font-size:17px;font-weight:800;letter-spacing:-0.015em\">{{ l.h }}</div>\n                <div style=\"font-size:15.5px;line-height:1.55;color:#44536b;margin-top:6px;text-wrap:pretty\">{{ l.p }}</div>\n              </div>\n           