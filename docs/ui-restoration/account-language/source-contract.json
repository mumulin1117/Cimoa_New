    "fragment": "<sc-if value=\"{{ isSetLang }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Settings / Language / Default\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">Language</div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 60px;box-sizing:border-box\">\n          <div style=\"display:flex;flex-direction:column;gap:10px\">\n            <sc-for list=\"{{ langOptions }}\" as=\"o\" hint-placeholder-count=\"2\">\n              <div sc-camel-on-click=\"{{ o.pick }}\" style=\"display:flex;align-items:center;gap:12px;padding:18px;border-radius:20px;background:{{ o.bg }};border:{{ o.border }};box-shadow:0 8px 22px rgba(16,36,74,0.05);cursor:pointer\">\n                <div style=\"flex:1;font-size:18px;font-weight:700\">{{ o.label }}</div>\n                <sc-if value=\"{{ o.sel }}\" hint-placeholder-val=\"{{ false }}\">\n                  <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#4a7bf7\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"></path></svg>\n                </sc-if>\n              </div>\n            </sc-for>\n          </div>\n        </div>\n      </div>\n    </sc-if>"
  },
