    "fragment": "<sc-if value=\"{{ isReverify }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Profile / Verification / Reverify\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">Re-verify university</div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 130px;box-sizing:border-box\">\n          <div style=\"font-size:16px;color:#5b6b85;text-wrap:pretty\">Needed if your university email changed, your last verification expired, or your account needs a status review.</div>\n          <div style=\"margin-top:16px;padding:18px;border-radius:22px;background:rgba(255,255,255,0.7)\">\n            <div style=\"font-size:16px;font-weight:700\">While this is pending</div>\n            <div style=\"font-size:15.5px;color:#44536b;margin-top:6px;line-height:1.5;text-wrap:pretty\">Your existing conversations stay visible. Discover, Auto Match, and new connection requests are temporarily restricted until verification finishes.</div>\n          </div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:34px;z-index:20\"><div sc-camel-on-click=\"{{ goVerEmail }}\" style=\"height:60px;border-radius:30px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 12px 26px rgba(168,85,247,0.24)\"><div style=\"font-size:19px;font-weight:700;color:#fff\">Start Re-verification</div></div></div>\n      </div>\n    </sc-if>"
  },
