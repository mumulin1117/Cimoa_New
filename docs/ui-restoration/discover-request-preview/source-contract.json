    "fragment": "    <!-- ===================== ICEBREAKER · VOICE PREVIEW ===================== -->\n    <sc-if value=\"{{ isIbPreview }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Discover / Icebreaker / Voice Preview\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">Voice preview</div>\n          \n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:120px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 170px;box-sizing:border-box\">\n          <div style=\"padding:16px 18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <div style=\"font-size:13px;font-weight:700;letter-spacing:0.08em;color:#8b95a6\">CHLOE’S QUESTION</div>\n            <div style=\"font-size:18px;font-weight:700;letter-spacing:-0.015em;margin-top:6px;text-wrap:pretty\">{{ qText }}</div>\n          </div>\n          <div style=\"margin-top:18px;padding:22px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);display:flex;align-items:center;gap:18px\">\n            <div sc-camel-on-click=\"{{ togglePlay }}\" style=\"width:64px;height:64px;border-radius:32px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n              <sc-if value=\"{{ playing }}\" hint-placeholder-val=\"{{ false }}\">\n                <svg width=\"26\" height=\"26\" sc-camel-view-box=\"0 0 24 24\" fill=\"#fff\"><rect x=\"6\" y=\"4\" width=\"4.5\" height=\"16\" rx=\"1.6\"></rect><rect x=\"13.5\" y=\"4\" width=\"4.5\" height=\"16\" rx=\"1.6\"></rect></svg>\n              </sc-if>\n              <sc-if value=\"{{ paused }}\" hint-placeholder-val=\"{{ true }}\">\n                <svg width=\"30\" height=\"30\" sc-camel-view-box=\"0 0 24 24\" fill=\"#fff\" stroke=\"#fff\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><path d=\"M7.5 5 18.5 12 7.5 19z\"></path></svg>\n              </sc-if>\n            </div>\n            <div style=\"flex:1;min-width:0\">\n              <div style=\"height:8px;border-radius:4px;background:#e6ecf5;overflow:hidden\">\n                <div style=\"height:8px;border-radius:4px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);width:{{ playWidth }};transition:width 300ms ease\"></div>\n              </div>\n              <div style=\"display:flex;justify-content:space-between;margin-top:9px\">\n                <div style=\"font-size:15px;color:#6b7a93;font-weight:600\">{{ playLabel }}</div>\n                <div style=\"font-size:15px;color:#6b7a93;font-variant-numeric:tabular-nums\">{{ voiceLen }}</div>\n              </div>\n            </div>\n          </div>\n          <div style=\"display:flex;justify-content:center;gap:48px;margin-top:18px\">\n            <div sc-camel-on-click=\"{{ deleteVoice }}\" aria-label=\"Delete\" style=\"display:flex;flex-direction:column;align-items:center;gap:7px;cursor:pointer\">\n              <div style=\"width:60px;height:60px;border-radius:30px;background:#fff;box-shadow:0 8px 22px rgba(16,36,74,0.08);display:flex;align-items:center;justify-content:center\">\n                <svg width=\"26\" height=\"26\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#dc2626\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 7h16\"></path><path d=\"M9.5 7V4.8c0-.4.4-.8.8-.8h3.4c.4 0 .8.4.8.8V7\"></path><path d=\"M6 7l1 12.2c.1 1 .9 1.8 2 1.8h6c1.1 0 1.9-.8 2-1.8L18 7\"></path><path d=\"M10 11v6M14 11v6\"></path></svg>\n              </div>\n            </div>\n            <div sc-camel-on-click=\"{{ reRecord }}\" aria-label=\"Re-record\" style=\"display:flex;flex-direction:column;align-items:center;gap:7px;cursor:pointer\">\n              <div style=\"width:60px;height:60px;border-radius:30px;background:#fff;box-shadow:0 8px 22px rgba(16,36,74,0.08);display:flex;align-items:center;justify-content:center\">\n                <svg width=\"26\" height=\"26\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3.5 12a8.5 8.5 0 1 0 2.6-6.1\"></path><path d=\"M3.5 4v4.5H8\"></path><rect x=\"10\" y=\"8\" width=\"4\" height=\"6.5\" rx=\"2\"></rect><path d=\"M12 17v-1\"></path></svg>\n              </div>\n            </div>\n          </div>\n          <div style=\"font-size:14.5px;color:#6b7a93;text-align:center;margin-top:12px\">Introduction costs {{ costText }} · balance {{ balanceText }}</div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:34px;z-index:20\"><div sc-camel-on-click=\"{{ continueVoice }}\" style=\"height:60px;border-radius:30px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 12px 26px rgba(168,85,247,0.24)\"><div style=\"font-size:19px;font-weight:700;color:#fff\">Continue</div></div></div>\n      </div>\n    </sc-if>",
