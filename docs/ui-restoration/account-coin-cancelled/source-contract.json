    "fragment": "<sc-if value=\"{{ isCoinCancelled }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Coins / Purchase / Cancelled\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:196px;left:20px;right:20px;display:flex;flex-direction:column;align-items:center;gap:14px\">\n          <div style=\"width:88px;height:88px;border-radius:44px;background:#e8edf7;display:flex;align-items:center;justify-content:center\">\n            <svg width=\"40\" height=\"40\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#6b7a93\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M9 9l6 6M15 9l-6 6\"></path></svg>\n          </div>\n          <div style=\"font-size:29px;font-weight:800;letter-spacing:-0.035em\">Purchase cancelled</div>\n          <div style=\"font-size:17px;color:#5b6b85;text-align:center;max-width:280px;text-wrap:pretty\">Nothing was charged and your balance is unchanged.</div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:34px;display:flex;flex-direction:column;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ backToStore }}\" style=\"height:60px;border-radius:30px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 12px 26px rgba(168,85,247,0.24)\"><div style=\"font-size:19px;font-weight:700;color:#fff\">Back to Coin Store</div></div>\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"height:56px;border-radius:28px;background:#fff;box-shadow:0 8px 22px rgba(16,36,74,0.07);display:flex;align-items:center;justify-content:center;cursor:pointer\"><div style=\"font-size:18px;font-weight:600;color:#0b1b3a\">Close</div></div>\n        </div>\n      </div>\n    </sc-if>"
  },
