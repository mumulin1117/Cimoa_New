  "approved_deltas": [
    {
      "id": "photos-brand",
      "source": "INTERACTION_CONVENTIONS.md section 1.1",
      "delta": "Replace the source brand CIRCA with Cimoa on the photo permission copy only."
    },
    {
      "id": "photos-two-photo-gate",
      "source": "Source visible copy and DEVELOPMENT_CONVENTIONS.md no-fake-feedback rule",
      "delta": "The source state enables Continue after one photo even though both visible instructions require at least two. The project enforces two decoded owned photos and keeps Continue disabled below that threshold."
    },
    {
      "id": "photos-real-media-persistence",
      "source": "DEVELOPMENT_CONVENTIONS.md sections 5, 9.2 and 12.3",
      "delta": "The browser or WKWebView chooser must return real image blobs. Cimoa decodes and stores selected media in IndexedDB, shows custom Loading before the Store transaction, and reports cancellation, permission, decode and persistence failures without fake success."
    },
    {
      "id": "photos-permission-continue-cancel",
      "source": "2026-10-26 user permission-button request",
      "delta": "Custom permission buttons are Continue / Cancel. Continue invokes the existing system photo-selection path, which may present a system picker without broad-library authorization. Cancel returns to Photos with no picker/system request, media write or fabricated denied state. Only real picker/permission/decode failures expose the contextual error and Settings actions; system-owned dialog labels are unchanged."
    },
    {
      "id": "photos-action-closure",
      "source": "User authorization for missing album interactions and INTERACTION_CONVENTIONS.md section 1.1",
      "delta": "The source only shows a toast for a filled card. A custom bottom sheet completes replace, reorder, delete and set-primary actions named by the source hint, with confirmation before deletion."
    }
  ],
