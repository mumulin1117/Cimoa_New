    "fragment": "    <sc-if value=\"{{ isReqReceived }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Connections / Request Detail / Default\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:46px;display:flex;align-items:center;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1;display:flex;align-items:center;justify-content:center;gap:7px\"><div style=\"font-size:23px;font-weight:700;letter-spacing:-0.02em\">Lina, 21</div><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#1d9bf0\"></circle><path d=\"m7.5 12.4 3 3 6-6.4\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div>\n          <div sc-camel-on-click=\"{{ openReqMenu }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"#0b1b3a\"><circle cx=\"5\" cy=\"12\" r=\"1.9\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.9\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.9\"></circle></svg>\n          </div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 330px;box-sizing:border-box\">\n          <div style=\"position:relative;width:100%;aspect-ratio:3/4;border-radius:24px;overflow:hidden;box-shadow:0 12px 30px rgba(16,36,74,0.12)\">\n            <sc-if value=\"{{ isPhoto0 }}\" hint-placeholder-val=\"{{ true }}\"><img src=\"be199ee7-6704-4324-98d1-52394676c49a\" alt=\"Lina photo\" style=\"width:100%;height:100%;object-fit:cover;object-position:50% 22%;display:block;cursor:pointer\"></sc-if>\n            <sc-if value=\"{{ isPhoto1 }}\" hint-placeholder-val=\"{{ false }}\"><img src=\"7c94b5fa-a030-4722-860f-0d79d6dcfc3f\" alt=\"Lina photo\" style=\"width:100%;height:100%;object-fit:cover;object-position:50% 22%;display:block;cursor:pointer\"></sc-if>\n            <sc-if value=\"{{ isPhoto2 }}\" hint-placeholder-val=\"{{ false }}\"><img src=\"c448edd0-f94d-466e-bc08-4899beb0854a\" alt=\"Lina photo\" style=\"width:100%;height:100%;object-fit:cover;object-position:50% 22%;display:block;cursor:pointer\"></sc-if>\n            <div style=\"position:absolute;left:14px;right:14px;bottom:12px;display:flex;align-items:center;gap:12px;padding:8px;border-radius:22px;background:rgba(8,16,31,0.55);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);z-index:4\">\n              <div style=\"width:44px;height:44px;border-radius:12px;background:url(&quot;c540ffa8-6f8c-4149-8a02-c0b48c332694&quot;) center/cover no-repeat;flex:none\"></div>\n              <div style=\"flex:1;min-width:0\"><div style=\"font-size:15.5px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Good Luck, Babe!</div><div style=\"font-size:13px;color:rgba(255,255,255,0.8);white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">Chappell Roan</div></div>\n              <div sc-camel-on-click=\"{{ otherSongPlay }}\" style=\"width:44px;height:44px;border-radius:22px;background:#fff;display:flex;align-items:center;justify-content:center;flex:none;cursor:pointer\"><sc-if value=\"{{ otherPlayingNot }}\" hint-placeholder-val=\"{{ true }}\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" style=\"margin-left:2px\"><path d=\"M7 4.5v15a1 1 0 0 0 1.5.86l12-7.5a1 1 0 0 0 0-1.72l-12-7.5A1 1 0 0 0 7 4.5z\" fill=\"#a855f7\"></path></svg></sc-if><sc-if value=\"{{ otherPlaying }}\" hint-placeholder-val=\"{{ false }}\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\"><rect x=\"6\" y=\"4.5\" width=\"4\" height=\"15\" rx=\"1.3\" fill=\"#a855f7\"></rect><rect x=\"14\" y=\"4.5\" width=\"4\" height=\"15\" rx=\"1.3\" fill=\"#a855f7\"></rect></svg></sc-if></div>\n            </div>\n            <div sc-camel-on-click=\"{{ prevPhoto }}\" style=\"position:absolute;left:0;top:0;bottom:0;width:35%;cursor:pointer\"></div>\n            <div sc-camel-on-click=\"{{ nextPhoto }}\" style=\"position:absolute;right:0;top:0;bottom:0;width:35%;cursor:pointer\"></div>\n            <div style=\"position:absolute;top:14px;left:14px;right:14px;display:flex;gap:6px\">\n              <sc-for list=\"{{ profileDots }}\" as=\"d\" hint-placeholder-count=\"3\">\n                <div style=\"flex:1;height:3px;border-radius:2px;background:{{ d.bg }}\"></div>\n              </sc-for>\n            </div>\n          </div>\n\n          <div style=\"padding:18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.06);margin-top:20px;display:flex;flex-wrap:wrap;gap:8px\">\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 2v20M16 2v20M8 6h4M8 12h4M8 18h4\"></path></svg>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">165 cm</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 8.5l10-4.5 10 4.5-10 4.5z\"></path><path d=\"M6 10.8v4.4c0 1.4 2.7 2.8 6 2.8s6-1.4 6-2.8v-4.4\"></path><path d=\"M22 8.5v5\"></path></svg>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">HKU</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.5 5.5c3.2-1 6.3-.7 9.5 1.2 3.2-1.9 6.3-2.2 9.5-1.2v13c-3.2-1-6.3-.7-9.5 1.2-3.2-1.9-6.3-2.2-9.5-1.2z\"></path><path d=\"M12 6.7v13\"></path></svg>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">Psychology</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9.2 3.8a2.3 2.3 0 0 1 4.6 0V5H17a1 1 0 0 1 1 1v3.3h1.2a2.3 2.3 0 0 1 0 4.6H18V18a1 1 0 0 1-1 1h-3.3v-1.2a2.3 2.3 0 0 0-4.6 0V19H6a1 1 0 0 1-1-1v-3.4h1.2a2.3 2.3 0 0 0 0-4.6H5V6a1 1 0 0 1 1-1h3.2z\"></path></svg>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">INFJ</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <div style=\"font-size:17px;line-height:1;flex:none\">🇲🇾</div>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">Malaysia</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <div style=\"font-size:17px;line-height:1;flex:none\">🍷</div>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">Never</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <div style=\"font-size:17px;line-height:1;flex:none\">🚭</div>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">Never</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <div style=\"font-size:17px;line-height:1;flex:none\">🕊️</div>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">Christian</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"8\" r=\"3.4\"></circle><path d=\"M3.5 20a5.5 5.5 0 0 1 11 0M16 5.2a3.4 3.4 0 0 1 0 5.6M17.5 20a5.6 5.6 0 0 0-2.2-4.4\"></path></svg>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">Psychology Society</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21s-7-6.2-7-11.4A7 7 0 0 1 19 9.6C19 14.8 12 21 12 21z\"></path><circle cx=\"12\" cy=\"9.4\" r=\"2.4\"></circle></svg>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">Pok Fu Lam</div>\n            </div>\n          </div>\n\n          <div style=\"margin-top:16px;padding:18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.06)\">\n            <div style=\"font-family:'Caveat',cursive;font-size:27px;font-weight:600;line-height:1.25;color:#26364f;text-align:center;text-wrap:balance\">Psych student who loves long walks, podcasts, and trying every dessert place in Kennedy Town.</div>\n          </div>\n\n          <div style=\"margin-top:16px;padding:18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.06)\">\n            <div style=\"display:flex;align-items:center;gap:10px\"><div style=\"width:36px;height:36px;border-radius:18px;background:#efe9fb;display:flex;align-items:center;justify-content:center;flex:none\"><svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#7c3aed\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"8\" r=\"3.4\"></circle><path d=\"M3.5 20a5.5 5.5 0 0 1 11 0M16 5.2a3.4 3.4 0 0 1 0 5.6M17.5 20a5.6 5.6 0 0 0-2.2-4.4\"></path></svg></div><div style=\"font-size:22px;font-weight:800;letter-spacing:-0.02em\">Looking for</div></div>\n            <div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:12px\">\n              <div style=\"height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb;display:flex;align-items:center;gap:6px;font-size:14px;font-weight:500;color:#26364f\">🤝 New friends</div>\n              <div style=\"height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb;display:flex;align-items:center;gap:6px;font-size:14px;font-weight:500;color:#26364f\">📚 Study buddy</div>\n              <div style=\"height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb;display:flex;align-items:center;gap:6px;font-size:14px;font-weight:500;color:#26364f\">☕ Coffee chats</div>\n              <div style=\"height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb;display:flex;align-items:center;gap:6px;font-size:14px;font-weight:500;color:#26364f\">🗣️ Language exchange</div>\n              <div style=\"height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb;display:flex;align-items:center;gap:6px;font-size:14px;font-weight:500;color:#26364f\">🎉 Campus events</div>\n            </div>\n          </div>\n\n          <div style=\"margin-top:16px;padding:18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.06)\">\n            <div style=\"display:flex;align-items:center;gap:10px\"><div style=\"width:36px;height:36px;border-radius:18px;background:#e5f0ff;display:flex;align-items:center;justify-content:center;flex:none\"><svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l1.6 4.8L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.2z\"></path></svg></div><div style=\"font-size:22px;font-weight:800;letter-spacing:-0.02em\">Interests</div></div>\n            <div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:12px\">\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <div style=\"font-size:13px;line-height:1;flex:none\">📷</div>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">Photography</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <div style=\"font-size:13px;line-height:1;flex:none\">☕</div>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">Coffee</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#f4f7fb\">\n              <div style=\"font-size:13px;line-height:1;flex:none\">🎵</div>\n              <div style=\"font-size:14px;font-weight:500;color:#26364f\">Live music</div>\n            </div>\n          </div>\n        </div>\n\n        </div>\n        <div style=\"position:absolute;left:0;right:0;bottom:0;height:300px;background:linear-gradient(180deg,rgba(236,233,251,0) 0%,rgba(236,233,251,0.92) 35%,#ece9fb 100%);pointer-events:none;z-index:19\"></div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:108px;z-index:20\">\n          <div style=\"padding:16px 18px;background:#fff;border-radius:24px;box-shadow:0 10px 28px rgba(16,36,74,0.12)\">\n            <div style=\"font-size:16.5px;font-weight:700;letter-spacing:-0.015em\">How would you spend your ideal weekend?</div>\n            <div style=\"display:flex;align-items:center;gap:14px;margin-top:12px\">\n              <div sc-camel-on-click=\"{{ togglePlay }}\" style=\"width:48px;height:48px;border-radius:24px;background:linear-gradient(135deg,#4a7bf7,#c026d3);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n                <sc-if value=\"{{ liamPlaying }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"display:flex;gap:3px\"><div style=\"width:4px;height:14px;background:#fff;border-radius:2px\"></div><div style=\"width:4px;height:14px;background:#fff;border-radius:2px\"></div></div></sc-if>\n                <sc-if value=\"{{ liamNotPlaying }}\" hint-placeholder-val=\"{{ true }}\"><svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"#fff\" stroke=\"#fff\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"><path d=\"M7.5 5 18.5 12 7.5 19z\"></path></svg></sc-if>\n              </div>\n              <div sc-camel-on-click=\"{{ seekLiam }}\" style=\"flex:1;display:flex;align-items:center;gap:2px;height:24px;cursor:pointer\">\n                <sc-for list=\"{{ liamWave }}\" as=\"w\" hint-placeholder-count=\"18\">\n                  <div style=\"flex:1;height:{{ w.h }};border-radius:2px;background:{{ w.bg }}\"></div>\n                </sc-for>\n              </div>\n              <div style=\"font-size:15px;color:#6b7a93;flex:none;font-variant-numeric:tabular-nums\">0:18</div>\n            </div>\n          </div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:34px;display:flex;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ notNow }}\" style=\"flex:1;height:58px;border-radius:29px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.08);display:flex;align-items:center;justify-content:center;cursor:pointer\"><div style=\"font-size:18px;font-weight:700;color:#0b1b3a\">Not Now</div></div>\n          <div sc-camel-on-click=\"{{ accept }}\" style=\"flex:1;height:58px;border-radius:29px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 12px 26px rgba(168,85,247,0.24)\"><div style=\"font-size:18px;font-weight:700;color:#fff\">Accept</div></div>\n        </div>\n      </div>\n    </sc-if>"
  },
