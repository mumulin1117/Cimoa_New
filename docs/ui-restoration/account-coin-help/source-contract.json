    "fragment": "<sc-if value=\"{{ isCoinHelp }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Coins / Help / Default\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">About coins</div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 40px;box-sizing:border-box\">\n          <div style=\"display:flex;flex-direction:column;gap:10px\">\n            <sc-for list=\"{{ helpRows }}\" as=\"h\" hint-placeholder-count=\"7\">\n              <div style=\"padding:16px 18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n                <div sc-camel-on-click=\"{{ h.toggle }}\" style=\"display:flex;align-items:center;gap:12px;cursor:pointer\">\n                  <div style=\"flex:1;font-size:17px;font-weight:700;letter-spacing:-0.015em;text-wrap:pretty\">{{ h.q }}</div>\n                  <svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"flex:none;transform:{{ h.rot }};transition:transform 180ms ease\"><path d=\"M5 9l7 7 7-7\"></path></svg>\n                </div>\n                <sc-if value=\"{{ h.open }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"font-size:16px;line-height:1.5;color:#26364f;margin-top:10px;text-wrap:pretty\">{{ h.a }}</div>\n                </sc-if>\n              </div>\n            </sc-for>\n          </div>\n          <div style=\"display:flex;flex-direction:column;gap:10px;margin-top:18px\">\n            <div sc-camel-on-click=\"{{ openTerms }}\" style=\"display:flex;align-items:center;justify-content:space-between;padding:16px 18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\"><div style=\"font-size:17px;font-weight:600\">Terms of Use</div><svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M9 5l7 7-7 7\"></path></svg></div>\n            <div sc-camel-on-click=\"{{ openPrivacy }}\" style=\"display:flex;align-items:center;justify-content:space-between;padding:16px 18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\"><div style=\"font-size:17px;font-weight:600\">Privacy Policy</div><svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M9 5l7 7-7 7\"></path></svg></div>\n            <div sc-camel-on-click=\"{{ openSupport }}\" style=\"display:flex;align-items:center;justify-content:space-between;padding:16px 18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\"><div style=\"font-size:17px;font-weight:600\">Purchase support</div><svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M9 5l7 7-7 7\"></path></svg></div>\n          </div>\n        </div>\n      </div>\n    </sc-if>"
  },
