    "fragment": "    <sc-if value=\"{{ isAmConnected }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Auto Match / Result / Connected\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">Auto Match</div>\n        </div>\n        <div style=\"position:absolute;top:180px;left:20px;right:20px;display:flex;flex-direction:column;align-items:center;gap:16px\">\n          <div style=\"animation:cRise 520ms ease both\">          <div style=\"display:flex;align-items:center;justify-content:center\">\n            <img src=\"6cba2be3-a0e0-4813-b4ab-4aa65ed6aa30\" alt=\"Alex Chan\" style=\"width:92px;height:92px;border-radius:46px;object-fit:cover;border:4px solid #fff;display:block;box-shadow:0 10px 26px rgba(16,36,74,0.14)\">\n            <img src=\"c448edd0-f94d-466e-bc08-4899beb0854a\" alt=\"Chloe Lin\" style=\"width:92px;height:92px;border-radius:46px;object-fit:cover;border:4px solid #fff;margin-left:-24px;display:block;box-shadow:0 10px 26px rgba(16,36,74,0.14)\">\n          </div></div>\n          <div style=\"font-size:32px;font-weight:800;letter-spacing:-0.035em;text-align:center\">You both connected</div>\n          <div style=\"font-size:17px;color:#5b6b85;text-align:center;max-width:290px;text-wrap:pretty\">You and Chloe can now start a conversation.</div>\n          <div style=\"font-size:14px;color:#8b95a6\">Matched via Auto Match</div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:34px;display:flex;flex-direction:column;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ startChat }}\" style=\"height:60px;border-radius:30px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 12px 26px rgba(168,85,247,0.24)\"><div style=\"font-size:19px;font-weight:700;color:#fff\">Start Chatting</div></div>\n          <div sc-camel-on-click=\"{{ viewProfile }}\" style=\"height:56px;border-radius:28px;background:#fff;box-shadow:0 8px 22px rgba(16,36,74,0.07);display:flex;align-items:center;justify-content:center;cursor:pointer\"><div style=\"font-size:18px;font-weight:600;color:#0b1b3a\">View Profile</div></div>\n        </div>\n      </div>\n    </sc-if>",
