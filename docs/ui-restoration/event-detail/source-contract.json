    "fragment": "<sc-if value=\"{{ isEvDetail }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"{{ screenName }}\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div class=\"cscroll\" style=\"position:absolute;inset:0;overflow-y:auto;scrollbar-width:none;padding:0 0 200px;box-sizing:border-box\">\n          <div style=\"position:relative;width:100%;height:330px\">\n            <img src=\"b8e65a72-456c-4c6d-ac60-b015015a3ac4\" alt=\"{{ evTitle }}\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n            <div sc-camel-on-click=\"{{ goBack }}\" style=\"position:absolute;top:58px;left:20px;width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.16);display:flex;align-items:center;justify-content:center;cursor:pointer\">\n              <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n            </div>\n            <div sc-camel-on-click=\"{{ openEventMore }}\" style=\"position:absolute;top:58px;right:20px;width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.16);display:flex;align-items:center;justify-content:center;cursor:pointer\">\n              <svg width=\"20\" height=\"20\" sc-camel-view-box=\"0 0 24 24\" fill=\"#0b1b3a\"><circle cx=\"5\" cy=\"12\" r=\"1.9\"></circle><circle cx=\"12\" cy=\"12\" r=\"1.9\"></circle><circle cx=\"19\" cy=\"12\" r=\"1.9\"></circle></svg>\n            </div>\n          </div>\n          <div style=\"padding:0 20px\">\n          <div style=\"font-size:32px;font-weight:800;letter-spacing:-0.035em;margin-top:20px;line-height:1.1\">{{ evTitle }}</div>\n          <div style=\"display:flex;align-items:center;gap:12px;margin-top:14px;padding:12px 14px;background:#fff;border-radius:20px;box-shadow:0 6px 18px rgba(16,36,74,0.06)\">\n            <div style=\"width:44px;height:44px;border-radius:14px;background:#e8f1fd;display:flex;align-items:center;justify-content:center;flex:none;font-size:15px;font-weight:800;color:#1e4b8f\">SU</div>\n            <div style=\"flex:1;min-width:0\"><div style=\"font-size:12.5px;font-weight:700;letter-spacing:0.06em;color:#8b95a6\">HOSTED BY</div><div style=\"display:flex;align-items:center;gap:6px;margin-top:2px\"><div style=\"font-size:17px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">HKUST Student Union</div><svg width=\"17\" height=\"17\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" style=\"flex:none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#1d9bf0\"></circle><path d=\"m7.5 12.4 3 3 6-6.4\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div></div></div>\n\n          <div style=\"margin-top:18px;padding:8px 4px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <div style=\"display:flex;align-items:center;gap:14px;padding:10px 14px\">\n              <div style=\"width:40px;height:40px;border-radius:20px;background:#efe9fb;display:flex;align-items:center;justify-content:center;flex:none\"><svg width=\"19\" height=\"19\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#7c3aed\" stroke-width=\"1.9\" stroke-linecap=\"round\" style=\"flex:none\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"></rect><path d=\"M8 3v3M16 3v3M3 10h18\"></path></svg></div>\n              <div style=\"font-size:17px;font-weight:600\">{{ evWhen }}</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:14px;padding:10px 14px\">\n              <div style=\"width:40px;height:40px;border-radius:20px;background:#e5f0ff;display:flex;align-items:center;justify-content:center;flex:none\"><svg width=\"19\" height=\"19\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"flex:none\"><path d=\"M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z\"></path><circle cx=\"12\" cy=\"10\" r=\"2.6\"></circle></svg></div>\n              <div style=\"font-size:17px;font-weight:600\">{{ evPlace }}</div>\n            </div>\n            <div style=\"display:flex;align-items:flex-start;gap:14px;padding:10px 14px\">\n              <div style=\"width:40px;height:40px;border-radius:20px;background:#fbe6f7;display:flex;align-items:center;justify-content:center;flex:none\"><svg width=\"19\" height=\"19\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#b6249e\" stroke-width=\"1.9\" stroke-linecap=\"round\" style=\"flex:none\"><circle cx=\"9\" cy=\"8\" r=\"3.4\"></circle><path d=\"M3.5 20a5.5 5.5 0 0 1 11 0M16 5.2a3.4 3.4 0 0 1 0 5.6M17.5 20a5.6 5.6 0 0 0-2.2-4.4\"></path></svg></div>\n              <div style=\"flex:1;min-width:0\">\n                <div style=\"font-size:17px;font-weight:600\">{{ evAttendance }}</div>\n                <div sc-camel-on-click=\"{{ openParticipantsList }}\" style=\"display:flex;align-items:center;gap:10px;margin-top:8px;cursor:pointer\">\n                  <div style=\"display:flex\">\n                    <img src=\"ceafb32c-3d48-4ad1-a03e-d45b4d907d80\" alt=\"\" style=\"width:32px;height:32px;border-radius:16px;object-fit:cover;border:2px solid #fff;display:block\">\n                    <img src=\"e8bd8155-5a13-4ecb-a022-bcadf12ae5f6\" alt=\"\" style=\"width:32px;height:32px;border-radius:16px;object-fit:cover;border:2px solid #fff;margin-left:-10px;display:block\">\n                    <img src=\"38b22b41-ac8f-43cc-8bf0-37a8b75c93b4\" alt=\"\" style=\"width:32px;height:32px;border-radius:16px;object-fit:cover;border:2px solid #fff;margin-left:-10px;display:block\">\n                    <img src=\"92ddcb8c-721c-4960-a8e8-51926692ee27\" alt=\"\" style=\"width:32px;height:32px;border-radius:16px;object-fit:cover;border:2px solid #fff;margin-left:-10px;display:block\">\n                  </div>\n                  <div style=\"font-size:15px;color:#8b95a6\">+{{ evExtra }}</div>\n                  <div style=\"font-size:16px;font-weight:700;color:#4a7bf7\">View participants ›</div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div style=\"font-size:17px;line-height:1.5;color:#26364f;margin-top:18px;text-wrap:pretty\">Bring a snack, meet someone new, and watch the sunset together.</div>\n\n          <div style=\"margin-top:22px;font-size:20px;font-weight:800;letter-spacing:-0.02em\">Schedule</div>\n          <div style=\"margin-top:12px;padding:18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <div style=\"display:flex;gap:14px\"><div style=\"display:flex;flex-direction:column;align-items:center;flex:none;width:12px\"><div style=\"width:10px;height:10px;border-radius:5px;background:linear-gradient(135deg,#1ec8f5,#a855f7);margin-top:6px\"></div><div style=\"flex:1;width:2px;background:#eef1f6;margin-top:4px\"></div></div><div style=\"flex:1;min-width:0;padding-bottom:16px\"><div style=\"font-size:14px;font-weight:700;color:#8b95a6\">5:30 PM</div><div style=\"font-size:17px;font-weight:700;margin-top:2px\">Meet &amp; mingle</div><div style=\"font-size:15px;color:#5b6b85;margin-top:2px\">Grab a spot on the lawn and say hi</div></div></div>\n            <div style=\"display:flex;gap:14px\"><div style=\"display:flex;flex-direction:column;align-items:center;flex:none;width:12px\"><div style=\"width:10px;height:10px;border-radius:5px;background:linear-gradient(135deg,#1ec8f5,#a855f7);margin-top:6px\"></div><div style=\"flex:1;width:2px;background:#eef1f6;margin-top:4px\"></div></div><div style=\"flex:1;min-width:0;padding-bottom:16px\"><div style=\"font-size:14px;font-weight:700;color:#8b95a6\">6:00 PM</div><div style=\"font-size:17px;font-weight:700;margin-top:2px\">Icebreaker games</div><div style=\"font-size:15px;color:#5b6b85;margin-top:2px\">Small groups of 4–5, mixed faculties</div></div></div>\n            <div style=\"display:flex;gap:14px\"><div style=\"display:flex;flex-direction:column;align-items:center;flex:none;width:12px\"><div style=\"width:10px;height:10px;border-radius:5px;background:linear-gradient(135deg,#1ec8f5,#a855f7);margin-top:6px\"></div></div><div style=\"flex:1;min-width:0;padding-bottom:0px\"><div style=\"font-size:14px;font-weight:700;color:#8b95a6\">6:35 PM</div><div style=\"font-size:17px;font-weight:700;margin-top:2px\">Sunset</div><div style=\"font-size:15px;color:#5b6b85;margin-top:2px\">Golden hour over Clear Water Bay</div></div></div>\n          </div>\n          <div style=\"margin-top:22px;font-size:20px;font-weight:800;letter-spacing:-0.02em\">Good to know</div>\n          <div style=\"margin-top:12px;display:flex;flex-wrap:wrap;gap:8px\"><div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#fff;box-shadow:0 4px 12px rgba(16,36,74,0.06)\"><div style=\"font-size:17px;line-height:1\">🆓</div><div style=\"font-size:14px;font-weight:500;color:#26364f\">Free to join</div></div><div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#fff;box-shadow:0 4px 12px rgba(16,36,74,0.06)\"><div style=\"font-size:17px;line-height:1\">🧺</div><div style=\"font-size:14px;font-weight:500;color:#26364f\">Bring a picnic mat</div></div><div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#fff;box-shadow:0 4px 12px rgba(16,36,74,0.06)\"><div style=\"font-size:17px;line-height:1\">🗣️</div><div style=\"font-size:14px;font-weight:500;color:#26364f\">English &amp; Cantonese</div></div><div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#fff;box-shadow:0 4px 12px rgba(16,36,74,0.06)\"><div style=\"font-size:17px;line-height:1\">♿</div><div style=\"font-size:14px;font-weight:500;color:#26364f\">Step-free access</div></div><div style=\"display:flex;align-items:center;gap:6px;height:34px;padding:0 12px;border-radius:17px;background:#fff;box-shadow:0 4px 12px rgba(16,36,74,0.06)\"><div style=\"font-size:17px;line-height:1\">🌧️</div><div style=\"font-size:14px;font-weight:500;color:#26364f\">Moves indoors if it rains</div></div></div>\n          <sc-if value=\"{{ evJoinedFlag }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"margin-top:18px;padding:16px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n              <div style=\"display:flex;align-items:center;gap:10px\">\n                <div style=\"width:32px;height:32px;border-radius:16px;background:#e8f1fd;display:flex;align-items:center;justify-content:center;flex:none;font-size:12px;font-weight:800;color:#1e4b8f\">SU</div>\n                <div style=\"flex:1;min-width:0\"><div style=\"font-size:16px;font-weight:700\">HKUST Student Union</div><div style=\"font-size:14px;color:#8b95a6\">Organizer update</div></div>\n                <div style=\"font-size:14px;color:#8b95a6;flex:none\">2h ago</div>\n              </div>\n              <div style=\"font-size:16px;color:#26364f;margin-top:10px\">Meet by the sculpture at 5:20 PM.</div>\n            </div>\n          </sc-if>\n          </div>\n        </div>\n        <sc-if value=\"{{ evNotJoined }}\" hint-placeholder-val=\"{{ true }}\">\n          <div style=\"position:absolute;left:20px;right:20px;bottom:34px;z-index:20\"><div sc-camel-on-click=\"{{ askJoin }}\" style=\"height:60px;border-radius:30px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 12px 26px rgba(168,85,247,0.24)\"><div style=\"font-size:19px;font-weight:700;color:#fff\">Join Event</div></div></div>\n        </sc-if>\n        <sc-if value=\"{{ evJoinedFlag }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"position:absolute;left:20px;right:20px;bottom:34px;display:flex;flex-direction:column;gap:12px;z-index:20\">\n            <div sc-camel-on-click=\"{{ openGroup }}\" style=\"height:60px;border-radius:30px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;box-shadow:0 12px 26px rgba(168,85,247,0.24)\"><svg width=\"24\" height=\"24\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3.8c4.8 0 8.5 3.3 8.5 7.6s-3.7 7.6-8.5 7.6c-1.1 0-2.2-.2-3.2-.5-.4-.1-.8-.1-1.2.1l-2.4 1.2c-.6.3-1.2-.2-1-.8l.6-2c.1-.4 0-.8-.2-1.1C3.9 14.6 3.5 13 3.5 11.4 3.5 7.1 7.2 3.8 12 3.8z\"></path></svg><div style=\"font-size:19px;font-weight:700;color:#fff\">Open Group Chat</div></div>\n            <div sc-camel-on-click=\"{{ manageAttendance }}\" style=\"height:56px;border-radius:28px;background:#fff;box-shadow:0 8px 22px rgba(16,36,74,0.07);display:flex;align-items:center;justify-content:center;cursor:pointer\"><div style=\"font-size:18px;font-weight:600;color:#0b1b3a\">Manage Attendance</div></div>\n          </div>\n        </sc-if>\n      </div>\n    </sc-if>"
  },
