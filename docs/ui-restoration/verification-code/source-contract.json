  "approved_deltas": [
    {
      "id": "verification-code-safe-area-and-skeleton",
      "source": "DEVELOPMENT_CONVENTIONS.md 15.1",
      "delta": "Replace prototype system chrome and footer compensation with measured safe areas, fixed header/footer and one flex middle scroll region while preserving reference coordinates."
    },
    {
      "id": "verification-code-fixed-local-code",
      "source": "User authorized fixed local verification code 009789 and explicitly deferred real email verification",
      "delta": "Do not claim that an email was sent, resent, owned or that student status was verified. Use the locked approved local title, heading, description, code hint, info copy and button copy while preserving source geometry."
    },
    {
      "id": "verification-code-entity-guard",
      "source": "DEVELOPMENT_CONVENTIONS.md 5 and INTERACTION_CONVENTIONS.md 9.2",
      "delta": "Only a real pending or authenticated local account may be verified. Missing or expired context discloses no email, writes nothing and routes to Login."
    },
    {
      "id": "verification-code-atomic-write",
      "source": "Existing Store apply_verification contract",
      "delta": "The exact string 009789 shows custom 400-600ms Loading before one atomic local_verification write. Wrong format, wrong code, cancellation, account switch or persistence failure stays here with no partial write."
    },
    {
      "id": "verification-code-return-ownership",
      "source": "DEVELOPMENT_CONVENTIONS.md 11.2.1",
      "delta": "Back restores the actual auth origin and direct entry falls back to Login. Change email opens the real correction page for the same account."
    },
    {
      "id": "verification-code-keyboard-viewport",
      "source": "DEVELOPMENT_CONVENTIONS.md 14 and 15.1.2",
      "delta": "When the real keyboard reduces visualViewport height, keep the six-digit input region visible in the only scroll region and fold the fixed footer until the keyboard closes."
    }
  ],
