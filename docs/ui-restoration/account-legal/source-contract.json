tems:center;gap:12px;height:60px;padding:0 18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);text-decoration:none;color:#0b1b3a\"><div style=\"flex:1;font-size:17px;font-weight:600\">Privacy Policy</div><svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M9 5l7 7-7 7\"></path></svg></a>\n            <div sc-camel-on-click=\"{{ openAgreeInfo }}\" style=\"display:flex;align-items:center;gap:12px;height:60px;padding:0 18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\"><div style=\"flex:1;font-size:17px;font-weight:600\">Community Guidelines</div><svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M9 5l7 7-7 7\"></path></svg></div>\n            <div sc-camel-on-click=\"{{ openCoinHelp }}\" style=\"display:flex;align-items:center;gap:12px;height:60px;padding:0 18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\"><div style=\"flex:1;font-size:17px;font-weight:600\">Coin and Purchase Information</div><svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M9 5l7 7-7 7\"></path></svg></div>\n          </div>\n        </div>\n      </div>\n    </sc-if>"
