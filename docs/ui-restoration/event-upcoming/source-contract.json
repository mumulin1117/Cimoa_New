    "fragment": "<sc-if value=\"{{ isEvUpcoming }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Events / My Events / Upcoming\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">My events</div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 40px;box-sizing:border-box\">\n          <sc-if value=\"{{ true }}\" hint-placeholder-val=\"{{ true }}\">\n            <div sc-camel-on-click=\"{{ openJoined }}\" style=\"margin-top:4px;padding:16px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\">\n              <div style=\"display:flex;align-items:center;gap:12px\">\n                <img src=\"b8e65a72-456c-4c6d-ac60-b015015a3ac4\" alt=\"{{ evTitle }}\" style=\"width:64px;height:64px;border-radius:18px;object-fit:cover;flex:none;display:block\">\n                <div style=\"flex:1;min-width:0\">\n                  <div style=\"font-size:19px;font-weight:800;letter-spacing:-0.025em\">{{ evTitle }}</div>\n                  <div style=\"font-size:15px;color:#5b6b85;margin-top:3px\">{{ evWhen }}</div>\n                  <div style=\"font-size:15px;color:#5b6b85\">{{ evPlace }}</div>\n                </div>\n              </div>\n              <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px\">\n                <div sc-camel-on-click=\"{{ openGroupStop }}\" style=\"height:48px;border-radius:24px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;font-weight:700;color:#fff;box-shadow:0 8px 18px rgba(168,85,247,0.22)\">Group chat</div>\n                <div sc-camel-on-click=\"{{ manageStop }}\" style=\"height:48px;border-radius:24px;background:#fff;border:1.5px solid #e2e8f0;box-sizing:border-box;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;font-weight:700;color:#0b1b3a\">Manage</div>\n              </div>\n            </div>\n          </sc-if>\n          <div style=\"margin-top:24px;font-size:19px;font-weight:800;letter-spacing:-0.02em\">This week</div>\n          <div style=\"display:flex;flex-direction:column;gap:12px;margin-top:12px\">\n            <div sc-camel-on-click=\"{{ openJoined }}\" style=\"display:flex;align-items:center;gap:14px;padding:14px;background:#fff;border-radius:22px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\">\n              <div style=\"width:64px;height:64px;border-radius:16px;background:url(&quot;a6735a36-9d89-4906-822b-bc9e0793dab6&quot;) center/cover no-repeat;flex:none\"></div>\n              <div style=\"flex:1;min-width:0\"><div style=\"font-size:17px;font-weight:800;letter-spacing:-0.02em\">Open Mic Night</div><div style=\"font-size:14.5px;color:#5b6b85;margin-top:3px\">Thu · 8:00 PM</div><div style=\"font-size:14.5px;color:#5b6b85;margin-top:1px\">Student Centre · 18 going</div></div>\n              <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\" style=\"flex:none\"><path d=\"M9 5l7 7-7 7\"></path></svg>\n            </div>\n            <div sc-camel-on-click=\"{{ openJoined }}\" style=\"display:flex;align-items:center;gap:14px;padding:14px;background:#fff;border-radius:22px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\">\n              <div style=\"width:64px;height:64px;border-radius:16px;background:url(&quot;f505a1ed-f13f-4b85-bfb5-0982f9b3402d&quot;) center/cover no-repeat;flex:none\"></div>\n              <div style=\"flex:1;min-width:0\"><div style=\"font-size:17px;font-weight:800;letter-spacing:-0.02em\">Beginner Badminton</div><div style=\"font-size:14.5px;color:#5b6b85;margin-top:3px\">Fri · 7:00 PM</div><div style=\"font-size:14.5px;color:#5b6b85;margin-top:1px\">Sports Hall · 24 going</div></div>\n              <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\" style=\"flex:none\"><path d=\"M9 5l7 7-7 7\"></path></svg>\n            </div>\n          </div>\n          <div style=\"margin-top:24px;font-size:19px;font-weight:800;letter-spacing:-0.02em\">Past</div>\n          <div style=\"display:flex;flex-direction:column;gap:12px;margin-top:12px\">\n            <div sc-camel-on-click=\"{{ openJoined }}\" style=\"display:flex;align-items:center;gap:14px;padding:14px;background:#fff;border-radius:22px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\">\n              <div style=\"width:64px;height:64px;border-radius:16px;background:url(&quot;4ec95bce-b04a-4536-bc0d-1fcef78d7756&quot;) center/cover no-repeat;flex:none\"></div>\n              <div style=\"flex:1;min-width:0\"><div style=\"font-size:17px;font-weight:800;letter-spacing:-0.02em\">Coffee &amp; Sketch</div><div style=\"font-size:14.5px;color:#5b6b85;margin-top:3px\">Last week</div><div style=\"font-size:14.5px;color:#5b6b85;margin-top:1px\">Art Studio · 15 went</div></div>\n              <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\" style=\"flex:none\"><path d=\"M9 5l7 7-7 7\"></path></svg>\n            </div>\n          </div>\n        </div>\n      </div>\n    </sc-if>"
