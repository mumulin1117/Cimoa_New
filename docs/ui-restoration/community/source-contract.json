  "approved_deltas": [
    {
      "id": "community-brand",
      "source": "INTERACTION_CONVENTIONS.md 1.1",
      "delta": "Replace CIRCA with Cimoa in the heading without changing typography or surrounding copy."
    },
    {
      "id": "community-safe-area-and-skeleton",
      "source": "DEVELOPMENT_CONVENTIONS.md 15.1",
      "delta": "Replace prototype system chrome and absolute footer compensation with measured Top/BottomSafeArea, a fixed header/footer and one flex middle scroll region while preserving source coordinates at the reference safe area."
    },
    {
      "id": "community-readable-local-agreements",
      "source": "INTERACTION_CONVENTIONS.md 9.1 and DEVELOPMENT_CONVENTIONS.md 4",
      "delta": "The visible source Read affordance opens a controlled bottom Sheet for the corresponding local prototype document. Read never toggles consent or persists state; missing production legal identity and promises remain explicit inside the document."
    },
    {
      "id": "community-hit-region-split",
      "source": "DEVELOPMENT_CONVENTIONS.md 10 and user-authorized complete interactions",
      "delta": "Because Read is an independent action, the source row is split into a label/checkbox toggle region and a Read region without changing row geometry. Each region receives a unique interaction ID, and the Read region must not overlap the toggle region."
    },
    {
      "id": "community-real-write",
      "source": "DEVELOPMENT_CONVENTIONS.md 5 and INTERACTION_CONVENTIONS.md 9.2",
      "delta": "Keep checkbox selection as in-memory form state. Continue requires all three explicit consents, shows the custom 400-600ms Loading, persists the complete agreement object atomically through Store, then pushes Signup. Failure stays on the page and preserves the retryable form."
    },
    {
      "id": "community-return-ownership",
      "source": "DEVELOPMENT_CONVENTIONS.md 11.2.1",
      "delta": "Back restores the existing Age instance; direct entry falls back to Age instead of inventing an origin."
    },
    {
      "id": "community-settings-entry-remap",
      "source": "INTERACTION_CONVENTIONS.md 11 and the normalized target route inventory",
      "delta": "The prototype reuses route agree from Settings through openAgreeInfo. The project keeps this page registration-only: authenticated Settings opens the same Community Guidelines document in AgreementSheet and returns to Settings, avoiding registration-consent writes and navigation to Signup."
    }
  ],
