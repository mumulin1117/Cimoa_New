 0%,rgba(6,14,28,0.55) 42%,rgba(6,14,28,0) 100%)\"></div>\n          <div style=\"position:absolute;left:22px;right:22px;bottom:16px;color:#fff\">\n            <div style=\"display:flex;align-items:center;gap:10px\">\n              <div style=\"font-size:31px;font-weight:800;letter-spacing:-0.03em\">Chloe, 21</div>\n              <svg width=\"26\" height=\"26\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#1d9bf0\"></circle><path d=\"m7.5 12.4 3 3 6-6.4\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n            </div>\n            <div style=\"display:flex;flex-wrap:nowrap;gap:7px;margin-top:12px\">\n              <div style=\"display:flex;align-items:center;gap:6px;height:36px;padding:0 12px;border-radius:18px;flex:none;background:rgba(14,16,22,0.72);border:1px solid rgba(255,255,255,0.10);backdrop-filter:blur(8px)\">\n                <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 8.5l10-4.5 10 4.5-10 4.5z\"></path><path d=\"M6 10.8v4.4c0 1.4 2.7 2.8 6 2.8s6-1.4 6-2.8v-4.4\"></path><path d=\"M22 8.5v5\"></path></svg>\n                <div style=\"font-size:15px;font-weight:600;color:#fff;white-space:nowrap\">HKUST</div>\n              </div>\n              <div style=\"display:flex;align-items:center;gap:6px;height:36px;padding:0 12px;border-radius:18px;flex:none;background:rgba(14,16,22,0.72);border:1px solid rgba(255,255,255,0.10);backdrop-filter:blur(8px)\">\n                <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.5 5.5c3.2-1 6.3-.7 9.5 1.2 3.2-1.9 6.3-2.2 9.5-1.2v13c-3.2-1-6.3-.7-9.5 1.2-3.2-1.9-6.3-2.2-9.5-1.2z\"></path><path d=\"M12 6.7v13\"></path></svg>\n                <div style=\"font-size:15px;font-weight:600;color:#fff;white-space:nowrap\">Business</div>\n              </div>\n              <div style=\"display:flex;align-items:center;gap:6px;height:36px;padding:0 12px;border-radius:18px;flex:none;background:rgba(14,16,22,0.72);border:1px solid rgba(255,255,255,0.10);backdrop-filter:blur(8px)\">\n                <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9.2 3.8a2.3 2.3 0 0 1 4.6 0V5H17a1 1 0 0 1 1 1v3.3h1.2a2.3 2.3 0 0 1 0 4.6H18V18a1 1 0 0 1-1 1h-3.3v-1.2a2.3 2.3 0 0 0-4.6 0V19H6a1 1 0 0 1-1-1v-3.4h1.2a2.3 2.3 0 0 0 0-4.6H5V6a1 1 0 0 1 1-1h3.2z\"></path></svg>\n                <div style=\"font-size:15px;font-weight:600;color:#fff;white-space:nowrap\">ENFP</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div sc-camel-on-click=\"{{ sayHi }}\" style=\"position:absolute;left:20px;right:20px;bottom:104px;height:60px;border-radius:30px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);box-shadow:0 12px 28px rgba(168,85,247,0.32);display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:20\">\n          <div style=\"font-size:21px;font-weight:700;color:#fff\">Send shot</div>\n        </div>\n      </div>\n    </sc-if>",
