    "fragment": "    <sc-if value=\"{{ isAmSearching }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Auto Match / Queue / Searching\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">Finding your match</div><div sc-camel-on-click=\"{{ openAmHelp }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\"><svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"></circle><path d=\"M9.3 9.2a2.7 2.7 0 1 1 3.9 2.4c-.9.5-1.4 1-1.4 2.1\"></path><path d=\"M12 17.2h.01\"></path></svg></div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:120px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 200px;box-sizing:border-box\">\n          <div style=\"display:flex;flex-direction:column;align-items:center;gap:20px;margin-top:18px\">\n            <div style=\"position:relative;width:184px;height:184px;display:flex;align-items:center;justify-content:center\">\n              <div style=\"position:absolute;inset:0;border-radius:92px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);opacity:0.16;animation:cPulse 2600ms ease-in-out infinite\"></div>\n              <div style=\"position:absolute;inset:26px;border-radius:66px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);opacity:0.22;animation:cPulse 2600ms ease-in-out infinite 400ms\"></div>\n              <div style=\"width:96px;height:96px;border-radius:48px;display:flex;align-items:center;justify-content:center\">\n                <div style=\"display:flex;align-items:center\">\n                  <img src=\"6cba2be3-a0e0-4813-b4ab-4aa65ed6aa30\" alt=\"You\" style=\"width:72px;height:72px;border-radius:36px;object-fit:cover;border:3px solid #fff;display:block;box-shadow:0 8px 20px rgba(16,36,74,0.16)\">\n                  <img src=\"ccb60bc3-7dec-4660-b8f0-dbdd63bf808c\" alt=\"Potential match\" style=\"width:72px;height:72px;border-radius:36px;object-fit:cover;border:3px solid #fff;margin-left:-22px;display:block;box-shadow:0 8px 20px rgba(16,36,74,0.16)\">\n                </div>\n              </div>\n            </div>\n          </div>\n          <div style=\"margin-top:22px;padding:22px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);text-align:center\">\n            <div style=\"font-size:14.5px;color:#5b6b85\">Queue position</div>\n            <div style=\"font-size:40px;font-weight:800;letter-spacing:-0.03em;margin-top:2px\">{{ queuePos }}</div>\n            <div style=\"display:inline-flex;align-items:center;gap:7px;height:36px;padding:0 16px;border-radius:18px;background:#e5f3ff;margin-top:10px\">\n              <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#2e7dd6\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M12 7v5l3.2 2\"></path></svg>\n              <div style=\"font-size:15px;font-weight:700;color:#2e7dd6\">{{ waitText }}</div>\n            </div>\n            <div style=\"height:1px;background:#eef1f6;margin:18px 0\"></div>\n            <div style=\"font-size:16px;color:#26364f;text-wrap:pretty\">Looking for someone who shares your interests.</div>\n            <div sc-camel-on-click=\"{{ openPrefs }}\" style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:14px;cursor:pointer\">\n              <div style=\"display:flex;align-items:center;gap:7px;height:38px;padding:0 14px;border-radius:19px;background:#e5f0ff;color:#3760c9;font-size:15px;font-weight:700\"><svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"8\" r=\"3.4\"></circle><path d=\"M3.5 20a5.5 5.5 0 0 1 11 0M16 5.2a3.4 3.4 0 0 1 0 5.6M17.5 20a5.6 5.6 0 0 0-2.2-4.4\"></path></svg>Friends</div>\n              <div style=\"display:flex;align-items:center;gap:7px;height:38px;padding:0 14px;border-radius:19px;background:#efe9fb;color:#7238c9;font-size:15px;font-weight:700\"><svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21s-7-6.2-7-11.4A7 7 0 0 1 19 9.6C19 14.8 12 21 12 21z\"></path><circle cx=\"12\" cy=\"9.4\" r=\"2.4\"></circle></svg>My campus</div>\n              <div style=\"display:flex;align-items:center;gap:7px;height:38px;padding:0 14px;border-radius:19px;background:#fbe6f7;color:#b6249e;font-size:15px;font-weight:700\"><svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z\"></path></svg>Shared interests</div>\n            </div>\n          </div>\n          <sc-if value=\"{{ priorityOn }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;align-items:center;gap:10px;margin-top:12px;height:52px;padding:0 18px;border-radius:26px;background:#f6ecfd\">\n              <div style=\"width:10px;height:10px;border-radius:5px;background:#a855f7\"></div>\n              <div style=\"font-size:16px;font-weight:700;color:#6b21a8;font-variant-numeric:tabular-nums\">{{ priorityTimer }}</div>\n            </div>\n          </sc-if>\n          <sc-if value=\"{{ priorityOff }}\" hint-placeholder-val=\"{{ true }}\">\n            <div sc-camel-on-click=\"{{ openBoost }}\" style=\"display:flex;align-items:center;gap:12px;margin-top:12px;padding:16px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07);cursor:pointer\">\n              <div style=\"width:44px;height:44px;border-radius:22px;background:#fdecd2;display:flex;align-items:center;justify-content:center;flex:none\"><svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"#e08a1e\"><path d=\"M4 8l3 3 5-6 5 6 3-3-2 10H6z\"></path></svg></div>\n              <div style=\"flex:1;min-width:0\"><div style=\"font-size:17px;font-weight:700\">Priority Match · 20 coins</div><div style=\"font-size:14.5px;color:#5b6b85;margin-top:2px\">Move closer to the front for 15 min</div></div>\n              <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.4\" stroke-linecap=\"round\" style=\"flex:none\"><path d=\"M9 5l7 7-7 7\"></path></svg>\n            </div>\n          </sc-if>\n          <div sc-camel-on-click=\"{{ showNoMatch }}\" style=\"font-size:14.5px;color:#8b95a6;text-align:center;margin-top:16px;cursor:pointer\">Nothing available? See options</div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:30px;display:flex;flex-direction:column;gap:6px;z-index:20\">\n          <div sc-camel-on-click=\"{{ pauseQueue }}\" style=\"height:60px;border-radius:30px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 12px 26px rgba(168,85,247,0.24)\"><div style=\"font-size:19px;font-weight:700;color:#fff\">Pause</div></div>\n          <div sc-camel-on-click=\"{{ askLeave }}\" style=\"height:46px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;font-weight:600;color:#6b7a93\">Leave Pool</div>\n        </div>\n      </div>\n    </sc-if>",
