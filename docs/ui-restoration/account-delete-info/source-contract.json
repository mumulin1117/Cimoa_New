    "fragment": "<sc-if value=\"{{ isDelInfo }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Settings / Delete Account / Information\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">Delete account</div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 190px;box-sizing:border-box\">\n          <div style=\"font-size:26px;font-weight:800;letter-spacing:-0.03em\">This removes your account</div>\n          <div style=\"font-size:16px;color:#5b6b85;margin-top:10px;line-height:1.5;text-wrap:pretty\">Logging out keeps your account. Deleting it is different — it permanently affects:</div>\n          <div style=\"display:flex;flex-direction:column;gap:9px;margin-top:16px;padding:18px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <div style=\"font-size:16.5px;color:#26364f\">Your profile and photos</div>\n            <div style=\"font-size:16.5px;color:#26364f\">Your connections and chat history</div>\n            <div style=\"font-size:16.5px;color:#26364f\">Your event participation</div>\n            <div style=\"font-size:16.5px;color:#26364f\">Your Auto Match history</div>\n            <div style=\"font-size:16.5px;color:#26364f\">Your remaining coin balance ({{ balanceText }})</div>\n          </div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:30px;display:flex;flex-direction:column;gap:10px;z-index:20\">\n          <div sc-camel-on-click=\"{{ openDelReason }}\" style=\"height:58px;border-radius:29px;background:#f4f7fb;display:flex;align-items:center;justify-content:center;cursor:pointer\"><div style=\"font-size:18px;font-weight:700;color:#0b1b3a\">Continue Account Deletion</div></div>\n          <div sc-camel-on-click=\"{{ keepAccount }}\" style=\"height:56px;border-radius:28px;background:#fff;box-shadow:0 8px 22px rgba(16,36,74,0.07);display:flex;align-items:center;justify-content:center;cursor:pointer\"><div style=\"font-size:18px;font-weight:600;color:#0b1b3a\">Keep My Account</div></div>\n        </div>\n      </div>\n    </sc-if>"
  },
