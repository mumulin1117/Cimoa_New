    "fragment": "<sc-if value=\"{{ isVerified }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Profile / Verification / Verified\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ goBack }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1\"></div><div style=\"position:absolute;left:58px;right:58px;top:0;bottom:0;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;pointer-events:none;font-size:21px;font-weight:700;letter-spacing:-0.025em\">University verification</div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 60px;box-sizing:border-box\">\n          <div style=\"display:flex;flex-direction:column;align-items:center;gap:12px;padding:26px 20px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <div style=\"width:76px;height:76px;border-radius:38px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;box-shadow:0 14px 28px rgba(168,85,247,0.24)\">\n              <svg width=\"34\" height=\"34\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"></path></svg>\n            </div>\n            <div style=\"font-size:23px;font-weight:800;letter-spacing:-0.03em\">Verified student</div>\n          </div>\n          <div style=\"margin-top:16px;padding:6px 18px 12px;background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(16,36,74,0.07)\">\n            <div style=\"display:flex;align-items:center;justify-content:space-between;height:52px;border-bottom:1px solid #eef1f6\">\n              <div style=\"font-size:17px;color:#5b6b85\">University</div>\n              <div style=\"font-size:17px;font-weight:700\">HKUST</div>\n            </div>\n            <div style=\"display:flex;align-items:center;justify-content:space-between;height:52px;border-bottom:1px solid #eef1f6\">\n              <div style=\"font-size:17px;color:#5b6b85\">Verified email</div>\n              <div style=\"font-size:17px;font-weight:700\">{{ maskedEmail }}</div>\n            </div>\n            <div style=\"display:flex;align-items:center;justify-content:space-between;height:52px;border-bottom:1px solid #eef1f6\">\n              <div style=\"font-size:17px;color:#5b6b85\">Verified on</div>\n              <div style=\"font-size:17px;font-weight:700\">12 Sep 2026</div>\n            </div>\n            <div style=\"display:flex;align-items:center;justify-content:space-between;height:52px;border-bottom:1px solid #eef1f6\">\n              <div style=\"font-size:17px;color:#5b6b85\">Status</div>\n              <div style=\"font-size:17px;font-weight:700\">Active</div>\n            </div>\n          </div>\n          <div style=\"font-size:15px;color:#8b95a6;margin-top:14px;text-wrap:pretty\">Your university email is never shown to other students.</div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:34px;z-index:20\"><div sc-camel-on-click=\"{{ openReverify }}\" style=\"height:56px;border-radius:28px;background:#fff;box-shadow:0 8px 22px rgba(16,36,74,0.07);display:flex;align-items:center;justify-content:center;cursor:pointer\"><div style=\"font-size:18px;font-weight:600;color:#0b1b3a\">Re-verify</div></div></div>\n      </div>\n    </sc-if>"
  },
