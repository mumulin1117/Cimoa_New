      "fragment": "<sc-if value=\"{{ sheetUniPicker }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Auto Match / Preferences / University\" style=\"position:absolute;inset:0;z-index:55\">\n        <div sc-camel-on-click=\"{{ closeSheet }}\" style=\"position:absolute;inset:0;background:rgba(8,16,31,0.42);backdrop-filter:blur(2px)\"></div>\n        <div style=\"position:absolute;left:0;right:0;bottom:0;top:150px;background:#fff;border-radius:32px 32px 0 0;padding:26px 22px 34px;box-shadow:0 -14px 40px rgba(8,16,31,0.22);animation:cRise 240ms ease both;box-sizing:border-box;display:flex;flex-direction:column\">\n          <div style=\"width:44px;height:5px;border-radius:3px;background:#dfe5ee;margin:0 auto 18px;flex:none\"></div>\n          <div style=\"font-size:24px;font-weight:800;letter-spacing:-0.03em;flex:none\">University</div>\n          <div style=\"display:flex;align-items:center;gap:10px;height:50px;padding:0 16px;border-radius:25px;background:#f4f7fb;margin-top:14px;flex:none\">\n            <svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#8b95a6\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"></circle><path d=\"M16.2 16.2 21 21\"></path></svg>\n            <input sc-camel-on-change=\"{{ onUniSearch }}\" value=\"{{ uniSearch }}\" placeholder=\"Search for a university\" style=\"flex:1;border:0;outline:0;background:transparent;font-family:inherit;font-size:16px;color:#0b1b3a\">\n          </div>\n          <div style=\"overflow-y:auto;margin-top:10px\">\n            <div style=\"display:flex;flex-direction:column;gap:10px\">\n              <sc-for list=\"{{ uniChips }}\" as=\"o\" hint-placeholder-count=\"8\">\n                <div sc-camel-on-click=\"{{ o.pick }}\" style=\"height:52px;padding:0 20px;border-radius:26px;display:flex;align-items:center;cursor:pointer;font-size:17px;font-weight:600;background:{{ o.bg }};color:{{ o.ink }}\">{{ o.label }}</div>\n              </sc-for>\n            </div>\n          </div>\n        </div>\n      </div>\n    </sc-if>"
    },
