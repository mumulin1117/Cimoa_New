    "fragment": "    <sc-if value=\"{{ isAmFound }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Auto Match / Found / Preview\" style=\"position:absolute;inset:0;animation:cRise 240ms ease both\">\n        <div style=\"position:absolute;top:58px;left:20px;right:20px;height:48px;display:flex;align-items:center;gap:12px;z-index:20\">\n          <div sc-camel-on-click=\"{{ askLeaveMatch }}\" style=\"width:46px;height:46px;border-radius:23px;background:#fff;box-shadow:0 6px 18px rgba(16,36,74,0.10);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\">\n            <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 5l-7 7 7 7\"></path></svg>\n          </div>\n          <div style=\"flex:1;display:flex;flex-direction:column;align-items:center;gap:2px\">\n            <svg width=\"26\" height=\"18\" sc-camel-view-box=\"0 0 26 18\" fill=\"none\" stroke-linecap=\"round\"><path d=\"M6 12 3 2\" stroke=\"#1ec8f5\" stroke-width=\"2.4\"></path><path d=\"M13 10V1\" stroke=\"#8a6ff0\" stroke-width=\"2.4\"></path><path d=\"M20 12l3-10\" stroke=\"#f81ce5\" stroke-width=\"2.4\"></path></svg>\n            <div style=\"font-size:21px;font-weight:700;letter-spacing:-0.025em\">Match found</div>\n          </div>\n          <div style=\"display:flex;align-items:center;gap:7px;height:38px;padding:0 14px;border-radius:19px;background:#fbe3f8;flex:none\">\n            <svg width=\"15\" height=\"15\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#9d1d8f\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M12 7v5l3.2 2\"></path></svg>\n            <div style=\"font-size:15px;font-weight:700;color:#9d1d8f;font-variant-numeric:tabular-nums\">{{ foundTimer }}</div>\n          </div>\n        </div>\n        <div class=\"cscroll\" style=\"position:absolute;top:118px;left:0;right:0;bottom:0;overflow-y:auto;scrollbar-width:none;padding:0 20px 210px;box-sizing:border-box\">\n          <div sc-camel-on-click=\"{{ openLimitedProfile }}\" style=\"position:relative;width:100%;height:340px;border-radius:24px;overflow:hidden;cursor:pointer;box-shadow:0 12px 30px rgba(16,36,74,0.12)\">\n            <img src=\"{{ amImg }}\" alt=\"{{ amName }}\" style=\"width:100%;height:100%;object-fit:cover;object-position:50% 26%;display:block\">\n            <div style=\"position:absolute;left:0;right:0;bottom:0;height:150px;background:linear-gradient(to top,rgba(6,14,28,0.8) 0%,rgba(6,14,28,0.35) 55%,rgba(6,14,28,0) 100%)\"></div>\n            <div style=\"position:absolute;left:20px;right:20px;bottom:16px;color:#fff\">\n              <div style=\"display:flex;align-items:center;gap:8px\">\n                <div style=\"font-size:27px;font-weight:800;letter-spacing:-0.03em\">{{ amName }}</div>\n                <svg width=\"22\" height=\"22\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#1d9bf0\"></circle><path d=\"m7.5 12.4 3 3 6-6.4\" stroke=\"#fff\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n              </div>\n              <div style=\"display:flex;flex-wrap:nowrap;gap:7px;margin-top:10px\">\n                <div style=\"display:flex;align-items:center;gap:6px;height:36px;padding:0 12px;border-radius:18px;flex:none;background:rgba(14,16,22,0.72);border:1px solid rgba(255,255,255,0.10);backdrop-filter:blur(8px)\">\n                  <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 8.5l10-4.5 10 4.5-10 4.5z\"></path><path d=\"M6 10.8v4.4c0 1.4 2.7 2.8 6 2.8s6-1.4 6-2.8v-4.4\"></path><path d=\"M22 8.5v5\"></path></svg>\n                  <div style=\"font-size:15px;font-weight:600;color:#fff;white-space:nowrap\">{{ amUni }}</div>\n                </div>\n                <div style=\"display:flex;align-items:center;gap:6px;height:36px;padding:0 12px;border-radius:18px;flex:none;background:rgba(14,16,22,0.72);border:1px solid rgba(255,255,255,0.10);backdrop-filter:blur(8px)\">\n                  <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2.5 5.5c3.2-1 6.3-.7 9.5 1.2 3.2-1.9 6.3-2.2 9.5-1.2v13c-3.2-1-6.3-.7-9.5 1.2-3.2-1.9-6.3-2.2-9.5-1.2z\"></path><path d=\"M12 6.7v13\"></path></svg>\n                  <div style=\"font-size:15px;font-weight:600;color:#fff;white-space:nowrap\">{{ amMajor }}</div>\n                </div>\n                <div style=\"display:flex;align-items:center;gap:6px;height:36px;padding:0 12px;border-radius:18px;flex:none;background:rgba(14,16,22,0.72);border:1px solid rgba(255,255,255,0.10);backdrop-filter:blur(8px)\">\n                  <svg width=\"16\" height=\"16\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9.2 3.8a2.3 2.3 0 0 1 4.6 0V5H17a1 1 0 0 1 1 1v3.3h1.2a2.3 2.3 0 0 1 0 4.6H18V18a1 1 0 0 1-1 1h-3.3v-1.2a2.3 2.3 0 0 0-4.6 0V19H6a1 1 0 0 1-1-1v-3.4h1.2a2.3 2.3 0 0 0 0-4.6H5V6a1 1 0 0 1 1-1h3.2z\"></path></svg>\n                  <div style=\"font-size:15px;font-weight:600;color:#fff;white-space:nowrap\">{{ amMbti }}</div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div style=\"font-size:26px;font-weight:800;letter-spacing:-0.025em;margin-top:22px\">You have a lot in common</div>\n          <div style=\"font-size:17px;color:#5b6b85;margin-top:6px\">You both enjoy photography, coffee, and live music.</div>\n          <div style=\"display:flex;flex-wrap:wrap;gap:10px;margin-top:14px\">\n            <div style=\"display:flex;align-items:center;gap:8px;height:44px;padding:0 16px;border-radius:22px;background:#e5f0ff;color:#2563eb\"><div style=\"font-size:19px;line-height:1;flex:none\">📷</div><div style=\"font-size:16px;font-weight:700\">Photography</div></div>\n            <div style=\"display:flex;align-items:center;gap:8px;height:44px;padding:0 16px;border-radius:22px;background:#efe9fb;color:#7c3aed\"><div style=\"font-size:19px;line-height:1;flex:none\">☕</div><div style=\"font-size:16px;font-weight:700\">Coffee</div></div>\n            <div style=\"display:flex;align-items:center;gap:8px;height:44px;padding:0 16px;border-radius:22px;background:#fbe6f7;color:#b6249e\"><div style=\"font-size:19px;line-height:1;flex:none\">🎵</div><div style=\"font-size:16px;font-weight:700\">Live Music</div></div>\n          </div>\n          <div style=\"height:1px;background:#eef1f6;margin:18px 0\"></div>\n          <div style=\"font-size:17px;color:#26364f;line-height:1.45;text-wrap:pretty\">{{ amBio }}</div>\n        </div>\n        <div style=\"position:absolute;left:20px;right:20px;bottom:30px;display:flex;flex-direction:column;align-items:center;gap:14px;z-index:20\">\n          <div style=\"display:flex;gap:12px;width:100%\">\n            <div sc-camel-on-click=\"{{ connectAsk }}\" style=\"flex:1;height:60px;border-radius:30px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 12px 26px rgba(168,85,247,0.24)\"><div style=\"font-size:19px;font-weight:700;color:#fff\">Connect</div></div>\n            <div sc-camel-on-click=\"{{ passMatch }}\" style=\"width:60px;height:60px;border-radius:30px;background:#fff;box-shadow:0 8px 22px rgba(16,36,74,0.07);display:flex;align-items:center;justify-content:center;cursor:pointer;flex:none\"><svg width=\"26\" height=\"26\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#0b1b3a\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6 6 18\"></path></svg></div>\n          </div>\n          <div sc-camel-on-click=\"{{ openLimitedProfile }}\" style=\"font-size:16px;font-weight:600;color:#4a7bf7;cursor:pointer\">View profile</div>\n        </div>\n      </div>\n    </sc-if>",
