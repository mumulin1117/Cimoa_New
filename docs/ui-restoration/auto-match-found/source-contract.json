      "fragment": "<sc-if value=\"{{ sheetAccepting }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-screen-label=\"Auto Match / Found / Accepting\" style=\"position:absolute;inset:0;z-index:55\">\n        <div sc-camel-on-click=\"{{ closeSheet }}\" style=\"position:absolute;inset:0;background:rgba(8,16,31,0.42);backdrop-filter:blur(2px)\"></div>\n        <div style=\"position:absolute;left:0;right:0;bottom:0;background:#fff;border-radius:32px 32px 0 0;padding:26px 22px 34px;box-shadow:0 -14px 40px rgba(8,16,31,0.22);animation:cRise 240ms ease both;box-sizing:border-box\">\n          <div style=\"width:44px;height:5px;border-radius:3px;background:#dfe5ee;margin:0 auto 18px\"></div>\n          <div style=\"display:flex;align-items:center;gap:14px\">\n            <img src=\"c448edd0-f94d-466e-bc08-4899beb0854a\" alt=\"Chloe Lin\" style=\"width:56px;height:56px;border-radius:28px;object-fit:cover;display:block;flex:none\">\n            <div style=\"font-size:25px;font-weight:800;letter-spacing:-0.03em\">Connect with Chloe?</div>\n          </div>\n          <div style=\"font-size:16px;color:#5b6b85;margin-top:12px;text-wrap:pretty\">If Chloe also accepts, you’ll be able to message and video call each other.</div>\n          <div sc-camel-on-click=\"{{ confirmConnect }}\" style=\"height:60px;border-radius:30px;background:linear-gradient(95deg,#1ec8f5 0%,#4a7bf7 34%,#a855f7 64%,#f81ce5 100%);display:flex;align-items:center;justify-content:center;cursor:pointer;margin-top:20px;box-shadow:0 12px 26px rgba(168,85,247,0.24)\"><div style=\"font-size:19px;font-weight:700;color:#fff\">Confirm</div></div>\n          <div sc-camel-on-click=\"{{ closeSheet }}\" style=\"height:56px;border-radius:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;margin-top:10px\"><div style=\"font-size:18px;font-weight:600;color:#6b7a93\">Not Yet</div></div>\n        </div>\n      </div>\n    </sc-if>"
    },
